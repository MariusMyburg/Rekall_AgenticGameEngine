<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <ItemGroup>
    <ProjectReference Include="..\Rekall.Age.Rendering.Abstractions\Rekall.Age.Rendering.Abstractions.csproj" />
    <ProjectReference Include="..\Rekall.Age.Rendering\Rekall.Age.Rendering.csproj" />
    <ProjectReference Include="..\Rekall.Age.Rendering.WebGpu\Rekall.Age.Rendering.WebGpu.csproj" />
    <ProjectReference Include="..\Rekall.Age.Runtime\Rekall.Age.Runtime.csproj" />
    <ProjectReference Include="..\Rekall.Age.Runtime.Abstractions\Rekall.Age.Runtime.Abstractions.csproj" />
    <ProjectReference Include="..\Rekall.Age.Workflows\Rekall.Age.Workflows.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <RuntimeIdentifiers>browser-wasm</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>
  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>
  <ItemGroup Condition="'$(RekallAgeWebGameContentPath)' != '' and Exists('$(RekallAgeWebGameContentPath)\game.manifest.json')">
    <Content Include="$(RekallAgeWebGameContentPath)\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="$(RekallAgeWebPublishInputsPath)"
          Condition="'$(RekallAgeWebPublishInputsPath)' != '' and Exists('$(RekallAgeWebPublishInputsPath)')" />
</Project>
