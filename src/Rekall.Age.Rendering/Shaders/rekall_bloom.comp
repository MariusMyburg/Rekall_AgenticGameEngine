#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D sceneHdr;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D bloomPyramid;

layout(push_constant) uniform BloomParameters
{
    float threshold;
    float intensity;
    vec2 sourceSize;
} parameters;

// Thresholded 4x4 box downsample. Tone mapping performs a normalized tent
// reconstruction, so the downsample/upsample pair preserves constant-image energy.
void main()
{
    ivec2 target = ivec2(gl_GlobalInvocationID.xy);
    ivec2 targetSize = imageSize(bloomPyramid);
    if (any(greaterThanEqual(target, targetSize)))
    {
        return;
    }

    vec2 texel = 1.0 / parameters.sourceSize;
    vec2 center = (vec2(target) + 0.5) / vec2(targetSize);
    vec3 sum = vec3(0.0);
    for (int y = -1; y <= 2; ++y)
    {
        for (int x = -1; x <= 2; ++x)
        {
            sum += texture(sceneHdr, center + vec2(x, y) * texel).rgb;
        }
    }

    vec3 average = sum * (1.0 / 16.0);
    float brightness = max(max(average.r, average.g), average.b);
    float knee = max(parameters.threshold * 0.5, 0.0001);
    float soft = clamp((brightness - parameters.threshold + knee) / (2.0 * knee), 0.0, 1.0);
    float contribution = max(brightness - parameters.threshold, 0.0) + soft * soft * knee;
    imageStore(bloomPyramid, target, vec4(average * contribution / max(brightness, 0.0001), 1.0));
}
