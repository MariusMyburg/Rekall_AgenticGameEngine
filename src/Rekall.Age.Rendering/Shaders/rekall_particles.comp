#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct ParticleState
{
    vec4 positionAge;
    vec4 velocityLife;
    vec4 color;
    vec4 data;
};

struct ParticleEmitter
{
    uvec4 range;
    uvec4 seedFlags;
    vec4 originLife;
    vec4 directionCone;
    vec4 speedDrag;
    vec4 gravityEmission;
    vec4 sizeSoft;
    vec4 colorStart;
    vec4 colorEnd;
    vec4 flipbook;
};

layout(set = 0, binding = 0, std430) readonly buffer PreviousParticles { ParticleState values[]; } previousParticles;
layout(set = 0, binding = 1, std430) writeonly buffer NextParticles { ParticleState values[]; } nextParticles;
layout(set = 0, binding = 2, std430) readonly buffer Emitters { ParticleEmitter values[]; } emitters;
layout(set = 0, binding = 3, std430) writeonly buffer ActiveIndices { uint values[]; } activeIndices;
layout(set = 0, binding = 4, std430) buffer IndirectArguments { uint values[]; } indirectArguments;

layout(push_constant) uniform ParticleSimulationParameters
{
    uint capacity;
    uint emitterCount;
    uint frameIndex;
    float deltaSeconds;
} parameters;

uint hashValue(uint value)
{
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    return value ^ (value >> 16);
}

bool inCircularSpawnRange(uint localIndex, uint start, uint count, uint capacity)
{
    if (count == 0u) return false;
    uint distance = (localIndex + capacity - start) % capacity;
    return distance < min(count, capacity);
}

void main()
{
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= parameters.capacity) return;

    ParticleEmitter emitter;
    bool found = false;
    uint localIndex = 0u;
    uint emitterIndex = 0u;
    for (uint index = 0u; index < parameters.emitterCount; ++index)
    {
        ParticleEmitter candidate = emitters.values[index];
        if (slot >= candidate.range.x && slot < candidate.range.x + candidate.range.y)
        {
            emitter = candidate;
            localIndex = slot - candidate.range.x;
            emitterIndex = index;
            found = true;
            break;
        }
    }
    if (!found) return;

    ParticleState particle = previousParticles.values[slot];
    bool alive = particle.velocityLife.w > 0.0 && particle.positionAge.w < particle.velocityLife.w;
    if (alive)
    {
        float damping = exp(-max(emitter.speedDrag.z, 0.0) * parameters.deltaSeconds);
        particle.velocityLife.xyz = (particle.velocityLife.xyz + emitter.gravityEmission.xyz * parameters.deltaSeconds) * damping;
        particle.positionAge.xyz += particle.velocityLife.xyz * parameters.deltaSeconds;
        particle.positionAge.w += parameters.deltaSeconds;
    }
    else if (inCircularSpawnRange(localIndex, emitter.range.z, emitter.range.w, emitter.range.y))
    {
        uint random = hashValue(emitter.seedFlags.x ^ slot ^ parameters.frameIndex);
        float unit = float(random & 0x00ffffffu) / float(0x01000000u);
        float speed = mix(emitter.speedDrag.x, emitter.speedDrag.y, unit);
        vec3 direction = normalize(emitter.directionCone.xyz + vec3(unit - 0.5, 0.0, fract(unit * 17.0) - 0.5) * emitter.directionCone.w);
        particle.positionAge = vec4(emitter.seedFlags.y != 0u ? vec3(0.0) : emitter.originLife.xyz, 0.0);
        particle.velocityLife = vec4(direction * speed, emitter.originLife.w);
        particle.color = emitter.colorStart;
        particle.data = vec4(emitter.sizeSoft.x, emitter.sizeSoft.z, emitter.gravityEmission.w, uintBitsToFloat(emitterIndex));
        alive = true;
    }

    if (alive)
    {
        float age = clamp(particle.positionAge.w / max(particle.velocityLife.w, 0.0001), 0.0, 1.0);
        particle.color = mix(emitter.colorStart, emitter.colorEnd, age);
        particle.data.x = mix(emitter.sizeSoft.x, emitter.sizeSoft.y, age);
        uint activeIndex = atomicAdd(indirectArguments.values[1], 1u);
        activeIndices.values[activeIndex] = slot;
    }
    nextParticles.values[slot] = particle;
}
