<Application x:Class="Rekall.Age.Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WorkbenchBackground" Color="#11151B" />
        <SolidColorBrush x:Key="ChromeBackground" Color="#171C23" />
        <SolidColorBrush x:Key="PanelBackground" Color="#1C222B" />
        <SolidColorBrush x:Key="PanelRaised" Color="#242C37" />
        <SolidColorBrush x:Key="PanelBorder" Color="#343E4B" />
        <SolidColorBrush x:Key="WorkbenchText" Color="#E7EDF5" />
        <SolidColorBrush x:Key="MutedText" Color="#91A0B2" />
        <SolidColorBrush x:Key="Accent" Color="#48C7E8" />
        <SolidColorBrush x:Key="Selection" Color="#214D61" />
        <SolidColorBrush x:Key="EditorHeaderBackground" Color="#20262E" />
        <SolidColorBrush x:Key="ViewportBackground" Color="#090C10" />
        <!-- Code-native icons remain sharp at any DPI and inherit the foreground of
             their containing control, so one system works across every theme. -->
        <Geometry x:Key="IconCreate">M3,2 L13,2 13,14 3,14 Z M5,5 L11,5 M8,3 L8,7</Geometry>
        <Geometry x:Key="IconOpen">M1,4 L6,4 8,6 15,6 13,14 2,14 Z M2,4 L2,2 7,2 9,4</Geometry>
        <Geometry x:Key="IconPlay">M3,2 L14,8 3,14 Z</Geometry>
        <Geometry x:Key="IconStop">M3,3 L13,3 13,13 3,13 Z</Geometry>
        <Geometry x:Key="IconPause">M3,2 L7,2 7,14 3,14 Z M9,2 L13,2 13,14 9,14 Z</Geometry>
        <Geometry x:Key="IconStep">M2,2 L5,2 5,14 2,14 Z M6,2 L14,8 6,14 Z</Geometry>
        <Geometry x:Key="IconSettings">M8,1 L10,2 12,1 15,4 14,6 15,8 14,12 12,12 10,15 6,15 4,12 2,12 1,8 2,6 1,4 4,1 6,2 Z M8,5 A3,3 0 1 0 8,11 A3,3 0 1 0 8,5</Geometry>
        <Geometry x:Key="IconLocalModel">M2,3 L14,3 14,12 2,12 Z M5,14 L11,14 M8,12 L8,14 M5,6 L7,8 5,10 M9,10 L12,10</Geometry>
        <Geometry x:Key="IconFileModel">M3,1 L10,1 14,5 14,15 3,15 Z M10,1 L10,5 14,5 M5,9 L12,9 M5,12 L10,12</Geometry>
        <Geometry x:Key="IconCloud">M4,13 C1,13 1,8 4,8 C4,4 10,3 12,7 C16,7 16,13 12,13 Z</Geometry>
        <Geometry x:Key="IconAccount">M8,2 A3,3 0 1 0 8,8 A3,3 0 1 0 8,2 M2,15 C2,10 14,10 14,15 Z</Geometry>
        <Geometry x:Key="IconDownload">M7,1 L9,1 9,9 12,6 14,8 8,14 2,8 4,6 7,9 Z M2,15 L14,15</Geometry>
        <Geometry x:Key="IconRefresh">M13,6 A5,5 0 1 0 13,11 M13,2 L13,6 9,6</Geometry>
        <Geometry x:Key="IconBrowse">M1,5 L7,5 9,7 15,7 13,14 2,14 Z M3,5 L3,3 8,3 10,5</Geometry>
        <Geometry x:Key="IconBack">M9,2 L3,8 9,14 M3,8 L15,8</Geometry>
        <Geometry x:Key="IconNext">M7,2 L13,8 7,14 M1,8 L13,8</Geometry>
        <Geometry x:Key="IconCheck">M2,8 L6,12 14,3</Geometry>
        <Geometry x:Key="IconAgent">M3,5 L13,5 13,14 3,14 Z M8,1 L8,5 M5,9 L5,10 M11,9 L11,10 M6,12 L10,12</Geometry>
        <Geometry x:Key="IconReset">M13,6 A5,5 0 1 0 13,11 M13,2 L13,6 9,6</Geometry>
        <Geometry x:Key="IconContentFile">M3,1 L10,1 14,5 14,15 3,15 Z M10,1 L10,5 14,5</Geometry>
        <Geometry x:Key="IconImport">M2,13 L14,13 M8,2 L8,10 M4,6 L8,10 12,6</Geometry>
        <Geometry x:Key="IconGrid">M2,2 L7,2 7,7 2,7 Z M9,2 L14,2 14,7 9,7 Z M2,9 L7,9 7,14 2,14 Z M9,9 L14,9 14,14 9,14 Z</Geometry>
        <Geometry x:Key="IconList">M2,3 L4,3 M6,3 L14,3 M2,8 L4,8 M6,8 L14,8 M2,13 L4,13 M6,13 L14,13</Geometry>
        <Style x:Key="StudioIconPath" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="StudioFilledIconPath" TargetType="Path" BasedOn="{StaticResource StudioIconPath}">
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="Stroke" Value="Transparent" />
        </Style>
        <!-- Prevent native WPF popup controls from inheriting the light Windows
             palette while the rest of Studio uses the dark workbench theme. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1C222B" />
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E7EDF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#214D61" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#214D61" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E7EDF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#214D61" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E7EDF5" />
        <Style TargetType="{x:Type Window}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{StaticResource WorkbenchBackground}" />
            <Setter Property="Foreground" Value="{StaticResource WorkbenchText}" />
        </Style>
        <Style TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="{StaticResource WorkbenchText}" /></Style>
        <Style TargetType="{x:Type Control}"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="Foreground" Value="{StaticResource WorkbenchText}" /></Style>
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource WorkbenchText}" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="MenuSurface"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path x:Name="SubmenuArrow" Grid.Column="1" Visibility="Collapsed"
                                          Margin="16,0,2,0" VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 0 8" Stroke="{StaticResource MutedText}"
                                          StrokeThickness="1.3" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Right" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="230" MaxHeight="620"
                                        Background="{StaticResource PanelBackground}"
                                        BorderBrush="{StaticResource PanelBorder}"
                                        BorderThickness="1" Padding="3">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuSurface" Property="Background" Value="{StaticResource Selection}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="5,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource PanelBorder}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="Foreground" Value="{StaticResource WorkbenchText}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="{StaticResource PanelRaised}" />
            <Setter Property="Foreground" Value="{StaticResource WorkbenchText}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MaxWidth" Value="520" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource PanelRaised}" /><Setter Property="Foreground" Value="{StaticResource WorkbenchText}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" /><Setter Property="Margin" Value="2" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Selection}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#17627A" /><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#12171E" /><Setter Property="Foreground" Value="{StaticResource WorkbenchText}" /><Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /><Setter Property="SelectionBrush" Value="{StaticResource Selection}" /><Setter Property="Padding" Value="7,5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="TextSurface" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextSurface" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#12171E" /><Setter Property="Foreground" Value="{StaticResource WorkbenchText}" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /><Setter Property="Padding" Value="7,5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <Border x:Name="ComboSurface" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                    <Grid Margin="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Selection" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center" IsHitTestVisible="False" TextElement.Foreground="{TemplateBinding Foreground}" />
                        <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" Visibility="Hidden" />
                        <Path Grid.Column="1" Data="M 2 5 L 7 10 L 12 5" Stroke="{StaticResource MutedText}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ToggleButton x:Name="DropButton" Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="3" Padding="2">
                            <ScrollViewer><ItemsPresenter /></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEditable" Value="True"><Setter TargetName="Selection" Property="Visibility" Value="Hidden" /><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" /><Setter TargetName="DropButton" Property="Width" Value="28" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}"><Setter Property="Background" Value="{StaticResource PanelBackground}" /><Setter Property="Foreground" Value="{StaticResource WorkbenchText}" /><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource Selection}" /></Trigger></Style.Triggers></Style>
        <Style TargetType="{x:Type ListBox}"><Setter Property="Background" Value="#151A21" /><Setter Property="Foreground" Value="{StaticResource WorkbenchText}" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /></Style>
        <Style TargetType="{x:Type ListBoxItem}"><Setter Property="Padding" Value="6,3" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Selection}" /></Trigger></Style.Triggers></Style>
        <Style TargetType="{x:Type TreeView}"><Setter Property="Background" Value="#151A21" /><Setter Property="Foreground" Value="{StaticResource WorkbenchText}" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /><Setter Property="Padding" Value="4" /></Style>
        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="Foreground" Value="{StaticResource WorkbenchText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="3" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Selection}" />
                    <Setter Property="Foreground" Value="{StaticResource WorkbenchText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ToolBar}"><Setter Property="Background" Value="{StaticResource ChromeBackground}" /><Setter Property="Foreground" Value="{StaticResource WorkbenchText}" /></Style>
        <Style TargetType="{x:Type TabControl}"><Setter Property="Background" Value="{StaticResource PanelBackground}" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /></Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="{StaticResource ChromeBackground}" /><Setter Property="Foreground" Value="{StaticResource MutedText}" /><Setter Property="Padding" Value="12,6" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}" Margin="0,0,2,0"><ContentPresenter ContentSource="Header" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{StaticResource PanelBackground}" /><Setter Property="Foreground" Value="{StaticResource Accent}" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="{StaticResource PanelRaised}" /><Setter Property="Foreground" Value="{StaticResource MutedText}" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /><Setter Property="Padding" Value="10,5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleSurface" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="{StaticResource Selection}" /><Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{StaticResource Accent}" /><Setter Property="Foreground" Value="{StaticResource Accent}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="EditorPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="EditorHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource EditorHeaderBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Resources>
</Application>
