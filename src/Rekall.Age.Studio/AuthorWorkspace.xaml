<UserControl x:Class="Rekall.Age.Studio.AuthorWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WorkbenchBackground}"
             Foreground="{StaticResource WorkbenchText}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AUTHOR WITH AI" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="Describe the game. AGE handles implementation, testing, and delivery."
                           FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="5" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Project: " Foreground="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding ProjectContextText}" FontWeight="SemiBold" />
                    <TextBlock Text="  ·  Scene: " Foreground="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding SceneNameInput}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource EditorPanel}" CornerRadius="5" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="MODEL PROVIDER" Style="{StaticResource SectionLabel}" />
                            <ComboBox ItemsSource="{Binding LanguageModelProviders}"
                                      SelectedItem="{Binding SelectedLanguageModelProvider, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" Margin="0,7,0,10" />

                            <Border Padding="10" Background="#151B22" CornerRadius="4" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOllamaSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Local Ollama" FontWeight="SemiBold" />
                                    <TextBlock Text="Uses models installed on this PC. No account sign-in is needed."
                                               Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,7" />
                                    <Button Content="Refresh local models" Command="{Binding RefreshLanguageModelsCommand}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="GgufConfiguration" Padding="10" Background="#151B22" CornerRadius="4" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGgufSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Local GGUF via Ollama" FontWeight="SemiBold" />
                                    <TextBlock Text="Choose a local GGUF file. Studio imports it through Ollama, then makes it available in the model list."
                                               Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,7" />
                                    <WrapPanel>
                                        <Button Content="Browse and import GGUF…" Click="OnImportGgufClick" />
                                        <Button Content="Refresh imported models" Command="{Binding RefreshLanguageModelsCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="OpenAiConfiguration" Padding="10" Background="#151B22" CornerRadius="4" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOpenAiSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="OpenAI API session" FontWeight="SemiBold" />
                                    <TextBlock Text="The key is held in memory for this Studio session only."
                                               Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,7" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="OpenAiApiKeyInput" PasswordChar="●" Padding="7,5" />
                                        <Button Grid.Column="1" Content="Apply key" Click="OnApplyOpenAiApiKeyClick" Margin="7,0,0,0" />
                                    </Grid>
                                    <Button Content="Refresh OpenAI models" Command="{Binding RefreshLanguageModelsCommand}"
                                            HorizontalAlignment="Left" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="KimiConfiguration" Padding="10" Background="#151B22" CornerRadius="4" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKimiSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Kimi API session" FontWeight="SemiBold" />
                                    <TextBlock Text="The Kimi key is held in memory for this Studio session only. KIMI_API_KEY and MOONSHOT_API_KEY are also supported."
                                               Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,7" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="KimiApiKeyInput" PasswordChar="●" Padding="7,5" />
                                        <Button Grid.Column="1" Content="Apply key" Click="OnApplyKimiApiKeyClick" Margin="7,0,0,0" />
                                    </Grid>
                                    <Button Content="Refresh Kimi models" Command="{Binding RefreshLanguageModelsCommand}"
                                            HorizontalAlignment="Left" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="CodexConfiguration" Padding="10" Background="#151B22" CornerRadius="4" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCodexSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Codex via ChatGPT" FontWeight="SemiBold" />
                                    <TextBlock Text="Authenticate Codex only when this provider is selected."
                                               Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,7" />
                                    <WrapPanel>
                                        <Button Content="Sign in to Codex" Command="{Binding SignInCodexCommand}" />
                                        <Button Content="Cancel sign-in" Command="{Binding CancelCodexSignInCommand}" />
                                    </WrapPanel>
                                    <Button Content="Refresh Codex models" Command="{Binding RefreshLanguageModelsCommand}"
                                            HorizontalAlignment="Left" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="MODEL" Style="{StaticResource SectionLabel}" />
                            <ComboBox ItemsSource="{Binding LanguageModels}"
                                      SelectedItem="{Binding SelectedLanguageModel, Mode=TwoWay}"
                                      IsEditable="False" Margin="0,7,0,10" />
                            <TextBlock Text="REASONING EFFORT" Style="{StaticResource SectionLabel}" />
                            <ComboBox ItemsSource="{Binding ReasoningEfforts}"
                                      SelectedItem="{Binding SelectedReasoningEffort, Mode=TwoWay}"
                                      Margin="0,7,0,10" />
                            <TextBlock Text="{Binding ProviderDisplayStatus}" Foreground="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource EditorPanel}" CornerRadius="5" Padding="14">
                        <StackPanel>
                            <TextBlock Text="WHAT DO YOU WANT TO BUILD?" Style="{StaticResource SectionLabel}" />
                            <Grid MinHeight="190" Margin="0,7,0,10">
                                <TextBox Text="{Binding AgentTaskInput, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Padding="9" />
                                <TextBlock Text="Describe a complete game in ordinary language: objective, controls, presentation, and how it should feel."
                                           Foreground="#68798C" Margin="12,10" TextWrapping="Wrap" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AgentTaskInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button Content="Run Agent" Command="{Binding RunAgentCommand}" Style="{StaticResource AccentButton}"
                                        Padding="16,8" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelAgentCommand}" Padding="16,8" Margin="8,2,2,2" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource EditorPanel}" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource EditorHeader}" Padding="14,11">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AUTHORING PROGRESS" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="9"
                                    Padding="9,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedLanguageModel}" Foreground="{StaticResource Accent}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding AgentLines}" BorderThickness="0" Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,2,2,5" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
