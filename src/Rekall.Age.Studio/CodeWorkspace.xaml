<UserControl x:Class="Rekall.Age.Studio.CodeWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WorkbenchBackground}">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource EditorPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource EditorHeader}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="PROJECT CODE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                            <TextBlock Text="Project-owned C# gameplay" FontSize="11" Foreground="{StaticResource MutedText}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="Refresh" Click="OnRefreshSourcesClick" Padding="8,3"
                                ToolTip="Reload the project module source list" />
                    </Grid>
                </Border>
                <ListBox x:Name="CodeSourceList" Grid.Row="1" Margin="7"
                         ItemsSource="{Binding CodeSources}"
                         SelectedItem="{Binding SelectedCodeSource, Mode=OneWay}"
                         SelectionChanged="OnCodeSourceSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding FileName}" FontFamily="Cascadia Code" FontSize="12" />
                                <TextBlock Text="{Binding ModuleName}" Foreground="{StaticResource MutedText}" FontSize="10" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="NEW ENTITY COMPONENT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                        <TextBlock Text="Creates project code, builds it, and attaches the component to the selected entity."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,9" />
                        <TextBlock Text="Module" Style="{StaticResource SectionLabel}" />
                        <TextBox Text="{Binding CodeModuleNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,6" />
                        <TextBlock Text="Component" Style="{StaticResource SectionLabel}" />
                        <TextBox Text="{Binding CodeComponentNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,6" />
                        <TextBlock Text="Runtime system" Style="{StaticResource SectionLabel}" />
                        <TextBox Text="{Binding CodeSystemNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" />
                        <Button Content="Create, build &amp; attach" Command="{Binding CreateAttachCodeComponentCommand}"
                                Style="{StaticResource AccentButton}" HorizontalContentAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" Background="{StaticResource PanelBorder}" />

        <Border Grid.Column="2" Style="{StaticResource EditorPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource EditorHeader}">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedCodeSource.FileName, TargetNullValue='NO SOURCE SELECTED'}"
                                       FontFamily="Cascadia Code" FontWeight="SemiBold" />
                            <TextBlock Text="  ●" Foreground="#F0B35A" FontSize="10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsCodeDirty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Save" Command="{Binding SaveCodeCommand}" Padding="10,3" />
                            <Button Content="Build" Command="{Binding BuildCodeCommand}" Style="{StaticResource AccentButton}" Padding="10,3" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBox Grid.Row="1" Text="{Binding CodeSourceText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Code" FontSize="13"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" SpellCheck.IsEnabled="False" Padding="13,10"
                         IsReadOnly="False" />
                <Border Grid.Row="2" Background="#141A21" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="9,5">
                    <TextBlock Text="{Binding SelectedCodeSourcePath, TargetNullValue='Select or create a module source'}"
                               FontFamily="Cascadia Code" FontSize="10" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="3" Width="6" Background="{StaticResource PanelBorder}" />

        <Border Grid.Column="4" Style="{StaticResource EditorPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource EditorHeader}">
                    <StackPanel>
                        <TextBlock Text="RUN &amp; DEBUG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                        <TextBlock Text="F5 launches the production AGE Player" FontSize="11" Foreground="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Margin="8">
                    <UniformGrid Columns="2">
                        <Button Content="Open file" Command="{Binding OpenCodeFileCommand}" />
                        <Button Content="Open project" Command="{Binding OpenCodeProjectCommand}" />
                        <Button Content="Visual Studio" Command="{Binding OpenCodeSolutionCommand}" />
                        <Button Content="VS Code" Command="{Binding OpenCodeInVsCodeCommand}" />
                    </UniformGrid>
                    <TextBlock Text="{Binding SelectedCodeProjectPath, TargetNullValue='Select a source to see its project path'}"
                               FontFamily="Cascadia Code" FontSize="10" Foreground="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="3,6,3,2" />
                    <TextBlock Text="{Binding CodeStatusText}" TextWrapping="Wrap" Margin="3,5,3,7" />
                    <Border Height="1" Background="{StaticResource PanelBorder}" />
                    <TextBlock Text="BUILD OUTPUT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="3,9,3,5" />
                </StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding CodeOutputLines}" Margin="8,0,8,8"
                         FontFamily="Cascadia Code" FontSize="10" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
