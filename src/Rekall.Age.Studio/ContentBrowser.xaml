<UserControl x:Class="Rekall.Age.Studio.ContentBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ContentBrowserRoot"
             AllowDrop="True"
             AutomationProperties.Name="Content Browser"
             SizeChanged="OnBrowserSizeChanged"
             DragEnter="OnFilesDragEnter" DragOver="OnFilesDragOver"
             DragLeave="OnFilesDragLeave" Drop="OnFilesDropped">
    <UserControl.Resources>
        <Geometry x:Key="IconContentModel">M2,5 L8,1 14,5 8,9 Z M2,5 L2,12 8,16 8,9 M14,5 L14,12 8,16</Geometry>
        <Geometry x:Key="IconContentImage">M2,2 L14,2 14,14 2,14 Z M4,11 L7,7 9,9 11,6 14,10 M5,5 A1,1 0 1 1 4.99,5</Geometry>
        <Geometry x:Key="IconContentAudio">M3,6 L7,6 11,2 11,14 7,10 3,10 Z M13,5 C15,7 15,9 13,11</Geometry>
        <Geometry x:Key="IconContentShader">M8,1 L15,8 8,15 1,8 Z M5,8 L8,5 11,8 8,11 Z</Geometry>
        <Geometry x:Key="IconContentCode">M6,3 L2,8 6,13 M10,3 L14,8 10,13</Geometry>
        <DataTemplate x:Key="ContentCardTemplate">
            <Grid MinWidth="180" Margin="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="4" Background="{StaticResource PanelRaised}" VerticalAlignment="Top">
                    <Grid>
                    <Path Margin="6">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource StudioIconPath}">
                                <Setter Property="Data" Value="{StaticResource IconContentFile}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Family}" Value="model"><Setter Property="Data" Value="{StaticResource IconContentModel}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Family}" Value="texture"><Setter Property="Data" Value="{StaticResource IconContentImage}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Family}" Value="audio"><Setter Property="Data" Value="{StaticResource IconContentAudio}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Family}" Value="shader"><Setter Property="Data" Value="{StaticResource IconContentShader}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Family}" Value="module-source"><Setter Property="Data" Value="{StaticResource IconContentCode}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Loaded="OnContentThumbnailLoaded" Unloaded="OnContentThumbnailUnloaded" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="7,0,0,0">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                    <TextBlock Text="{Binding Family}" Foreground="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PreviewHealth}" Foreground="{StaticResource Accent}" FontSize="10" ToolTip="{Binding PreviewSummary}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ContentCompactTemplate">
            <Grid Margin="2,1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                <Path Data="{StaticResource IconContentFile}" Style="{StaticResource StudioIconPath}" Width="13" Height="13" />
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                <TextBlock Grid.Column="2" Text="{Binding Family}" Foreground="{StaticResource MutedText}" FontSize="11" />
            </Grid>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ContentCardItemsPanel"><VirtualizingStackPanel /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ContentCompactItemsPanel"><VirtualizingStackPanel /></ItemsPanelTemplate>
    </UserControl.Resources>
    <Grid Background="{StaticResource PanelBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource EditorHeader}" Padding="8,4">
            <WrapPanel Orientation="Horizontal">
                <TextBox x:Name="ContentSearchBox" Width="190" MinWidth="120" Margin="0,2" Text="{Binding ContentSearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search content by name, family, kind, origin, or health"
                         AutomationProperties.Name="Search project content" />
                <ComboBox x:Name="ContentCategoryPicker" Width="145" Margin="6,2,0,2"
                          ItemsSource="{Binding ContentCategories}" SelectedItem="{Binding SelectedContentCategory}"
                          ToolTip="Show one content category" AutomationProperties.Name="Filter content category" />
                <Button x:Name="RefreshContentButton" Margin="6,2,0,2" Click="OnRefreshContentClick"
                        ToolTip="Refresh project content" AutomationProperties.Name="Refresh project content">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconRefresh}" Style="{StaticResource StudioIconPath}" /><TextBlock Text="Refresh" /></StackPanel>
                </Button>
                <Button x:Name="ImportContentButton" Margin="4,2,0,2" Click="OnImportContentClick"
                        ToolTip="Import model, texture, audio, or shader files" AutomationProperties.Name="Import content files">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconImport}" Style="{StaticResource StudioIconPath}" /><TextBlock Text="Import…" /></StackPanel>
                </Button>
                <Button x:Name="GenerateTextureButton" Margin="4,2,0,2" Click="OnGenerateTextureClick"
                        ToolTip="Generate and import a texture" AutomationProperties.Name="Generate texture">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconContentFile}" Style="{StaticResource StudioIconPath}" /><TextBlock Text="Generate Texture…" /></StackPanel>
                </Button>
                <ToggleButton x:Name="CardContentViewButton" Margin="12,2,0,2" IsChecked="True" Click="OnCardViewClick"
                              ToolTip="Show content as cards" AutomationProperties.Name="Card content view">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconGrid}" Style="{StaticResource StudioIconPath}" /><TextBlock Text="Cards" /></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="CompactContentViewButton" Margin="4,2,0,2" Click="OnCompactViewClick"
                              ToolTip="Show a compact content list" AutomationProperties.Name="Compact content view">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconList}" Style="{StaticResource StudioIconPath}" /><TextBlock Text="Compact" /></StackPanel>
                </ToggleButton>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1" Margin="6">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="CategoryColumn" Width="150" /><ColumnDefinition x:Name="CategorySplitterColumn" Width="5" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DetailsSplitterColumn" Width="5" /><ColumnDefinition x:Name="DetailsColumn" Width="250" /></Grid.ColumnDefinitions>
            <Border x:Name="CategoryPanel" Style="{StaticResource EditorPanel}" Margin="0,0,5,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" Style="{StaticResource SectionLabel}" Margin="8,7" />
                    <ListBox ItemsSource="{Binding ContentCategories}" SelectedItem="{Binding SelectedContentCategory}" BorderThickness="0" />
                </DockPanel>
            </Border>
            <GridSplitter x:Name="CategorySplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="2" Style="{StaticResource EditorPanel}">
                <Grid>
                    <ListView x:Name="ContentItemList" ItemsSource="{Binding FilteredContentCards}"
                              SelectedItem="{Binding SelectedContentCard, Mode=TwoWay}"
                              PreviewMouseLeftButtonDown="OnContentItemMouseDown"
                              PreviewMouseMove="OnContentItemMouseMove"
                              MouseDoubleClick="OnContentItemDoubleClick"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                        <ListView.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding OpenSelectedContentCommand}" />
                        </ListView.InputBindings>
                        <ListView.Style>
                            <Style TargetType="ListView">
                                <Setter Property="Background" Value="#151A21" />
                                <Setter Property="Foreground" Value="{StaticResource WorkbenchText}" />
                                <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
                                <Setter Property="ItemsPanel" Value="{StaticResource ContentCardItemsPanel}" />
                                <Setter Property="ItemTemplate" Value="{StaticResource ContentCardTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=CompactContentViewButton}" Value="True">
                                        <Setter Property="ItemsPanel" Value="{StaticResource ContentCompactItemsPanel}" />
                                        <Setter Property="ItemTemplate" Value="{StaticResource ContentCompactTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Style>
                    </ListView>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding FilteredContentItems.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Path Data="{StaticResource IconImport}" Style="{StaticResource StudioIconPath}" Width="28" Height="28" Margin="0,0,0,8" />
                        <TextBlock Text="No project content matches this view." HorizontalAlignment="Center" />
                        <TextBlock Text="Import files or drag and drop them here." Foreground="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <GridSplitter x:Name="DetailsSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />
            <Border x:Name="DetailsPanel" Grid.Column="4" Style="{StaticResource EditorPanel}" Margin="5,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="9">
                        <TextBlock Text="DETAILS" Style="{StaticResource SectionLabel}" />
                        <Border Height="112" Margin="0,6,0,5" Background="#11161D" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                            <Grid>
                                <Path Data="{StaticResource IconContentFile}" Style="{StaticResource StudioIconPath}" Width="32" Height="32" Opacity="0.55" />
                                <Image Source="{Binding SelectedContentPreview.Thumbnail}" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding SelectedContentItem.DisplayName, TargetNullValue=Nothing selected}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedContentItem.Kind}" Foreground="{StaticResource Accent}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding SelectedContentItem.Origin}" Foreground="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding SelectedContentItem.Path}" ToolTip="{Binding SelectedContentItem.Path}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding SelectedContentItem.Diagnostic}" Foreground="#E4B169" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding SelectedContentPreview.Health}" Foreground="{StaticResource Accent}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SelectedContentPreview.Summary}" Foreground="#E4B169" TextWrapping="Wrap" />
                        <Button Content="Open" Command="{Binding OpenSelectedContentCommand}" Margin="0,8,0,0" Style="{StaticResource AccentButton}" ToolTip="Open the selected content in its editor" AutomationProperties.Name="Open selected content" />
                        <TextBlock Text="INDEX WARNINGS" Style="{StaticResource SectionLabel}" Margin="0,12,0,4" />
                        <ItemsControl ItemsSource="{Binding ContentWarnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Summary}" Foreground="#E4B169" TextWrapping="Wrap" Margin="0,2" ToolTip="{Binding Code}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ContentStatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ContentStatusText}" />
                    <ItemsControl ItemsSource="{Binding ImportJobs}" MaxHeight="54"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ContentImportSummary}" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
