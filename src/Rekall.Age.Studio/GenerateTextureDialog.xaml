<Window x:Class="Rekall.Age.Studio.GenerateTextureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate Texture" Width="520" Height="535" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WorkbenchBackground}"
        Foreground="{StaticResource WorkbenchText}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Generate Texture" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
            <TextBlock Text="Create and import a project texture using the configured image provider." Foreground="{StaticResource MutedText}" Margin="0,5,0,16" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="100" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Prompt" Style="{StaticResource SectionLabel}" />
            <TextBox x:Name="PromptBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" />
            <TextBlock Grid.Row="2" Text="Display name" Style="{StaticResource SectionLabel}" Margin="0,10,0,0" />
            <TextBox x:Name="DisplayNameBox" Grid.Row="3" />
            <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Texture role" Style="{StaticResource SectionLabel}" /><ComboBox x:Name="RoleBox" SelectedIndex="0"><ComboBoxItem Content="baseColor" /><ComboBoxItem Content="normal" /><ComboBoxItem Content="roughness" /><ComboBoxItem Content="metallic" /><ComboBoxItem Content="emissive" /><ComboBoxItem Content="height" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Size" Style="{StaticResource SectionLabel}" /><ComboBox x:Name="SizeBox" SelectedIndex="0"><ComboBoxItem Content="1024x1024" /><ComboBoxItem Content="1536x1024" /><ComboBoxItem Content="1024x1536" /></ComboBox></StackPanel>
            </Grid>
            <TextBlock Grid.Row="5" Text="Quality" Style="{StaticResource SectionLabel}" Margin="0,10,0,0" />
            <ComboBox x:Name="QualityBox" Grid.Row="6" SelectedIndex="0"><ComboBoxItem Content="auto" /><ComboBoxItem Content="low" /><ComboBoxItem Content="medium" /><ComboBoxItem Content="high" /></ComboBox>
            <CheckBox x:Name="SeamlessBox" Grid.Row="7" Content="Seamless / tileable" Margin="0,12,0,0" />
            <TextBlock x:Name="ValidationText" Grid.Row="8" Foreground="#E16D76" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Grid.Row="9" Text="Uses OPENAI_API_KEY from the Studio environment. Credentials are never stored in the project." Foreground="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
            <Button Content="Generate" Click="OnGenerate" Style="{StaticResource AccentButton}" MinWidth="100" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
