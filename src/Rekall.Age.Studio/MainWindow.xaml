<Window x:Class="Rekall.Age.Studio.MainWindow" x:Name="StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Rekall.Age.Studio"
        Title="Rekall AGE Studio" Width="1500" Height="940" MinWidth="1120" MinHeight="700"
        Background="{StaticResource WorkbenchBackground}" Foreground="{StaticResource WorkbenchText}"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.OpenDocumentationCommand}"
                        Executed="OnOpenDocumentationExecuted" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{x:Static local:MainWindow.OpenDocumentationCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <local:RekallAgeStudioColorBrushConverter x:Key="InspectorColorBrushConverter" />

        <DataTemplate x:Key="InspectorBooleanEditorTemplate">
            <CheckBox Content="Enabled" IsThreeState="False"
                      IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Checked="OnInspectorBooleanChanged" Unchecked="OnInspectorBooleanChanged" />
        </DataTemplate>
        <DataTemplate x:Key="InspectorNumberEditorTemplate">
            <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Enter a finite number within the declared minimum and maximum."
                     KeyDown="OnInspectorTextEditorKeyDown"
                     LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" />
        </DataTemplate>
        <DataTemplate x:Key="InspectorIntegerEditorTemplate">
            <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Enter a whole number within the declared minimum and maximum."
                     KeyDown="OnInspectorTextEditorKeyDown"
                     LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" />
        </DataTemplate>
        <DataTemplate x:Key="InspectorEnumEditorTemplate">
            <ComboBox ItemsSource="{Binding ChoiceItems}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                      SelectedValue="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="False" SelectionChanged="OnInspectorChoiceChanged" />
        </DataTemplate>
        <DataTemplate x:Key="InspectorAssetRefEditorTemplate">
            <ComboBox ItemsSource="{Binding ChoiceItems}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                      SelectedValue="{Binding ReferenceValue, Mode=OneWay}"
                      Text="{Binding ReferenceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName"
                      SelectionChanged="OnInspectorReferenceChoiceChanged" KeyDown="OnInspectorReferenceEditorKeyDown"
                      LostKeyboardFocus="OnInspectorReferenceEditorLostKeyboardFocus" />
        </DataTemplate>
        <DataTemplate x:Key="InspectorEntityRefEditorTemplate">
            <ComboBox ItemsSource="{Binding ChoiceItems}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                      SelectedValue="{Binding ReferenceValue, Mode=OneWay}"
                      Text="{Binding ReferenceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName"
                      SelectionChanged="OnInspectorReferenceChoiceChanged" KeyDown="OnInspectorReferenceEditorKeyDown"
                      LostKeyboardFocus="OnInspectorReferenceEditorLostKeyboardFocus" />
        </DataTemplate>
        <DataTemplate x:Key="InspectorColorEditorTemplate">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ColorValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="#RRGGBB or #RRGGBBAA" KeyDown="OnInspectorTextEditorKeyDown"
                             LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" />
                    <Border Grid.Column="1" Margin="5,0,0,0" CornerRadius="3" BorderThickness="1"
                            BorderBrush="#64778C" Background="{Binding ColorValue, Converter={StaticResource InspectorColorBrushConverter}}"
                            ToolTip="Color preview; transparent indicates invalid color text." />
                </Grid>
                <UniformGrid Columns="4" Margin="0,4,0,0">
                    <StackPanel Margin="0,0,2,0"><TextBlock Text="R" FontSize="9" Foreground="{StaticResource MutedText}" /><TextBox Text="{Binding ColorRed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInspectorTextEditorKeyDown" LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" /></StackPanel>
                    <StackPanel Margin="2,0"><TextBlock Text="G" FontSize="9" Foreground="{StaticResource MutedText}" /><TextBox Text="{Binding ColorGreen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInspectorTextEditorKeyDown" LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" /></StackPanel>
                    <StackPanel Margin="2,0"><TextBlock Text="B" FontSize="9" Foreground="{StaticResource MutedText}" /><TextBox Text="{Binding ColorBlue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInspectorTextEditorKeyDown" LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" /></StackPanel>
                    <StackPanel Margin="2,0,0,0"><TextBlock Text="A" FontSize="9" Foreground="{StaticResource MutedText}" /><TextBox Text="{Binding ColorAlpha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInspectorTextEditorKeyDown" LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" /></StackPanel>
                </UniformGrid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="InspectorVector2EditorTemplate">
            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,2,0"><TextBlock Text="X" FontSize="9" Foreground="{StaticResource MutedText}" /><TextBox Text="{Binding VectorX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInspectorTextEditorKeyDown" LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" /></StackPanel>
                <StackPanel Margin="2,0,0,0"><TextBlock Text="Y" FontSize="9" Foreground="{StaticResource MutedText}" /><TextBox Text="{Binding VectorY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInspectorTextEditorKeyDown" LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" /></StackPanel>
            </UniformGrid>
        </DataTemplate>
        <DataTemplate x:Key="InspectorVector3EditorTemplate">
            <UniformGrid Columns="3">
                <StackPanel Margin="0,0,2,0"><TextBlock Text="X" FontSize="9" Foreground="{StaticResource MutedText}" /><TextBox Text="{Binding VectorX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInspectorTextEditorKeyDown" LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" /></StackPanel>
                <StackPanel Margin="2,0"><TextBlock Text="Y" FontSize="9" Foreground="{StaticResource MutedText}" /><TextBox Text="{Binding VectorY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInspectorTextEditorKeyDown" LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" /></StackPanel>
                <StackPanel Margin="2,0,0,0"><TextBlock Text="Z" FontSize="9" Foreground="{StaticResource MutedText}" /><TextBox Text="{Binding VectorZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInspectorTextEditorKeyDown" LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" /></StackPanel>
            </UniformGrid>
        </DataTemplate>
        <DataTemplate x:Key="InspectorVector4EditorTemplate">
            <UniformGrid Columns="4">
                <StackPanel Margin="0,0,2,0"><TextBlock Text="X" FontSize="9" Foreground="{StaticResource MutedText}" /><TextBox Text="{Binding VectorX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInspectorTextEditorKeyDown" LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" /></StackPanel>
                <StackPanel Margin="2,0"><TextBlock Text="Y" FontSize="9" Foreground="{StaticResource MutedText}" /><TextBox Text="{Binding VectorY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInspectorTextEditorKeyDown" LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" /></StackPanel>
                <StackPanel Margin="2,0"><TextBlock Text="Z" FontSize="9" Foreground="{StaticResource MutedText}" /><TextBox Text="{Binding VectorZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInspectorTextEditorKeyDown" LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" /></StackPanel>
                <StackPanel Margin="2,0,0,0"><TextBlock Text="W" FontSize="9" Foreground="{StaticResource MutedText}" /><TextBox Text="{Binding VectorW, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInspectorTextEditorKeyDown" LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" /></StackPanel>
            </UniformGrid>
        </DataTemplate>
        <DataTemplate x:Key="InspectorJsonEditorTemplate">
            <Expander Header="Structured JSON" IsExpanded="False">
                <StackPanel Margin="0,4,0,0">
                    <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Cascadia Mono, Consolas" AcceptsReturn="True" AcceptsTab="True"
                             MinHeight="64" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                             KeyDown="OnInspectorJsonEditorKeyDown" />
                    <Button Content="Apply JSON" HorizontalAlignment="Right" Style="{StaticResource AccentButton}"
                            Command="{Binding DataContext.CommitInspectorPropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" Padding="8,3" Margin="0,4,0,0" />
                </StackPanel>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="InspectorStringEditorTemplate">
            <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnInspectorTextEditorKeyDown"
                     LostKeyboardFocus="OnInspectorTextEditorLostKeyboardFocus" />
        </DataTemplate>

        <local:RekallAgeStudioInspectorEditorTemplateSelector x:Key="InspectorEditorTemplateSelector"
            BooleanTemplate="{StaticResource InspectorBooleanEditorTemplate}"
            NumberTemplate="{StaticResource InspectorNumberEditorTemplate}"
            IntegerTemplate="{StaticResource InspectorIntegerEditorTemplate}"
            EnumTemplate="{StaticResource InspectorEnumEditorTemplate}"
            AssetRefTemplate="{StaticResource InspectorAssetRefEditorTemplate}"
            EntityRefTemplate="{StaticResource InspectorEntityRefEditorTemplate}"
            ColorTemplate="{StaticResource InspectorColorEditorTemplate}"
            Vector2Template="{StaticResource InspectorVector2EditorTemplate}"
            Vector3Template="{StaticResource InspectorVector3EditorTemplate}"
            Vector4Template="{StaticResource InspectorVector4EditorTemplate}"
            JsonTemplate="{StaticResource InspectorJsonEditorTemplate}"
            StringTemplate="{StaticResource InspectorStringEditorTemplate}" />
    </Window.Resources>
    <DockPanel x:Name="WorkbenchRoot">
        <Menu x:Name="MainMenu" DockPanel.Dock="Top"
              Background="{StaticResource ChromeBackground}"
              Foreground="{StaticResource WorkbenchText}"
              BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <Menu.Resources>
                <!-- WPF's stock submenu popup otherwise falls back to the light OS menu
                     palette even though Studio is dark themed. Keep dynamically-created
                     example entries readable as well as the static File entries. -->
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1C222B" />
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E7EDF5" />
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#214D61" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E7EDF5" />
            </Menu.Resources>
            <MenuItem Header="_File">
                <MenuItem Header="_Create Project…" Click="OnCreateProjectClick" />
                <MenuItem Header="_Open Project…" Click="OnOpenProjectClick" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem x:Name="ExamplesMenu" Header="_Examples" />
            <MenuItem Header="_View">
                <MenuItem Header="_Content Browser" Click="OnShowContentBrowserClick"
                          ToolTip="Restore and focus the project Content Browser" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="Language Model Setup…" Click="OnLanguageModelSetupClick"
                          IsEnabled="{Binding CanOpenLanguageModelSetup, ElementName=StudioWindow}">
                    <MenuItem.Icon><Path Data="{StaticResource IconSettings}" Style="{StaticResource StudioIconPath}" Margin="0" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Documentation" InputGestureText="F1"
                          Command="{x:Static local:MainWindow.OpenDocumentationCommand}" />
            </MenuItem>
        </Menu>
        <Border x:Name="ProjectBar" DockPanel.Dock="Top" Background="{StaticResource ChromeBackground}" Padding="12,9" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Project" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedText}" />
                <TextBlock Grid.Column="1" Text="{Binding ProjectContextText}"
                           ToolTip="{Binding ProjectPathInput}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontWeight="SemiBold" Margin="0,0,12,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button x:Name="CreateProjectButton" Click="OnCreateProjectClick" ToolTip="Create a new AGE project" AutomationProperties.Name="Create project"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCreate}" Style="{StaticResource StudioIconPath}" /><TextBlock Text="Create Project…" /></StackPanel></Button>
                    <Button x:Name="OpenProjectButton" Click="OnOpenProjectClick" ToolTip="Choose and open an existing AGE project" AutomationProperties.Name="Open project"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconOpen}" Style="{StaticResource StudioIconPath}" /><TextBlock Text="Open Project…" /></StackPanel></Button>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="Scene" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedText}" />
                <ComboBox Grid.Column="4" ItemsSource="{Binding SceneNames}" SelectedItem="{Binding SceneNameInput}"
                          IsEditable="True" />
                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="6,0">
                    <Button Content="Switch" Command="{Binding SwitchSceneCommand}" Padding="8,2" />
                </StackPanel>
                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border CornerRadius="10" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="9,3" Margin="8,0">
                        <TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11" />
                    </Border>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextAlignment="Right"
                               Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" MaxWidth="440" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="MainToolbar" DockPanel.Dock="Top" Padding="7" Background="{StaticResource ChromeBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
          <WrapPanel Orientation="Horizontal">
            <Button Content="Undo" Command="{Binding UndoCommand}" />
            <Button Content="Redo" Command="{Binding RedoCommand}" />
            <Border Width="1" Margin="7,4" Background="{StaticResource PanelBorder}" />
            <Button Content="Add Entity" Command="{Binding AddEntityCommand}" />
            <Border Width="1" Margin="7,4" Background="{StaticResource PanelBorder}" />
            <Button Command="{Binding SimulateCommand}" Style="{StaticResource AccentButton}" ToolTip="Run the scene in this viewport without changing authored state" AutomationProperties.Name="Simulate scene"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPlay}" Style="{StaticResource StudioFilledIconPath}" /><TextBlock Text="Simulate" /></StackPanel></Button>
            <Button Content="{Binding PauseSimulationLabel}" Command="{Binding PauseSimulationCommand}" ToolTip="Pause or resume the live simulation clock" />
            <Button Content="Step" Command="{Binding StepSimulationCommand}" ToolTip="Advance a paused simulation by exactly one fixed frame" />
            <Button Command="{Binding PlayCommand}" ToolTip="Launch the game in the production Player" AutomationProperties.Name="Play game"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPlay}" Style="{StaticResource StudioFilledIconPath}" /><TextBlock Text="Play" /></StackPanel></Button>
            <Button Command="{Binding StopCommand}" ToolTip="Stop Simulate or Play and return to Edit" AutomationProperties.Name="Stop game or simulation"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconStop}" Style="{StaticResource StudioFilledIconPath}" /><TextBlock Text="Stop" /></StackPanel></Button>
            <ToggleButton Content="Live" IsChecked="{Binding IsLiveViewportEnabled, Mode=TwoWay}" Margin="7,2,2,2" ToolTip="Continuously update the viewport while simulating" />
            <Border Width="1" Margin="7,4" Background="{StaticResource PanelBorder}" />
            <Button Content="Capture" Command="{Binding CaptureCommand}" />
            <Button Content="Validate" Command="{Binding ValidateCommand}" />
            <Border Width="1" Margin="7,4" Background="{StaticResource PanelBorder}" />
            <Button Content="Package" Command="{Binding PackageCommand}" />
            <Button Content="Audit Package" Command="{Binding AuditPackageCommand}" />
            <ComboBox Width="105" Margin="4,0" ToolTip="Package target"
                      ItemsSource="{Binding PackageTargets}"
                      SelectedItem="{Binding SelectedPackageTarget}" />
            <Border Width="1" Margin="7,4" Background="{StaticResource PanelBorder}" />
            <Button Content="Publish Web" Command="{Binding PublishWebCommand}" />
            <Button Content="Audit Web" Command="{Binding AuditWebCommand}" />
          </WrapPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TabControl x:Name="WorkspaceSelector" Grid.Row="0" SelectionChanged="OnWorkspaceChanged"
                        SelectedValuePath="Tag" SelectedValue="{Binding SelectedStudioWorkspace, Mode=TwoWay}"
                        Background="{StaticResource ChromeBackground}" BorderThickness="0,0,0,1">
                <TabItem Header="Author" Tag="Author" />
                <TabItem Header="World" Tag="World" />
                <TabItem Header="Code" Tag="Code" />
                <TabItem Header="Modeling" Tag="Modeling" />
            </TabControl>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="Layout" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <Button Content="Default" Tag="Default" Click="OnLayoutPresetClick" />
                <Button Content="Authoring" Tag="Authoring" Click="OnLayoutPresetClick" />
                <Button Content="Debug" Tag="Debug" Click="OnLayoutPresetClick" />
                <Border Width="1" Margin="6,4" Background="{StaticResource PanelBorder}" />
                <Button Content="Hierarchy" Tag="Hierarchy" Click="OnTogglePanelClick" />
                <Button Content="Inspector" Tag="Inspector" Click="OnTogglePanelClick" />
                <Button Content="Output" Tag="Output" Click="OnTogglePanelClick" />
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Padding="10,6" Margin="8,8,8,0" CornerRadius="5"
                        Background="#332C5364" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLanguageModelSetupIncomplete, ElementName=StudioWindow}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="AI setup incomplete" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{StaticResource WorkbenchText}" />
                        <TextBlock Text=" · " Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <Button Content="Configure" Click="OnLanguageModelSetupClick" MinWidth="76" Padding="9,3"
                                IsEnabled="{Binding CanOpenLanguageModelSetup, ElementName=StudioWindow}" />
                    </WrapPanel>
                </Border>
                <local:AuthorWorkspace x:Name="AuthorWorkspaceHost" Grid.Row="1" />
            </Grid>
            <local:CodeWorkspace x:Name="CodeWorkspaceHost" Grid.Row="1" Visibility="Collapsed" />
            <Grid x:Name="WorldWorkspace" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HierarchyColumn" Width="340" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="InspectorColumn" Width="460" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="300" />
                <RowDefinition x:Name="OutputRow" Height="340" MinHeight="140" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HierarchyPanel" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="8" Padding="8"
                    Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Scene Hierarchy" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInspectorSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Selected entity name" Foreground="{StaticResource MutedText}" />
                        <Grid Margin="0,3,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding EntityNameInput, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Content="Rename" Command="{Binding RenameEntityCommand}" /></Grid>
                        <UniformGrid Columns="4">
                            <Button Content="Duplicate" Padding="5,4" Command="{Binding DuplicateEntityCommand}" />
                            <Button Content="Delete" Padding="5,4" Command="{Binding DeleteEntityCommand}" />
                            <Button Content="Show/Hide" Padding="5,4" Command="{Binding ToggleEntityVisibleCommand}" />
                            <Button Content="Lock" Padding="5,4" Command="{Binding ToggleEntityLockedCommand}" />
                        </UniformGrid>
                        <Button Content="Edit Linked Model" Click="OnEditLinkedModelClick"
                                IsEnabled="{Binding CanEditSelectedLinkedModel}"
                                ToolTip="Open this linked Model Asset's source mesh in the 3D Modeling workspace"
                                Margin="0,5,0,0" />
                        <TextBlock Text="Parent entity ID" Foreground="{StaticResource MutedText}" Margin="0,7,0,0" />
                        <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding ParentEntityIdInput, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Content="Parent" Command="{Binding ReparentEntityCommand}" /><Button Grid.Column="2" Content="Clear" Command="{Binding ClearEntityParentCommand}" /></Grid>
                    </StackPanel>
                    <TreeView x:Name="SceneHierarchyTree" ItemsSource="{Binding EntityNodes}" SelectedItemChanged="OnSelectedEntityChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}" /></HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Grid.Row="0" Margin="0,8,0,8" Background="#090C10"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#D9171C23" Padding="12,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                <TextBlock Text="View style" Foreground="#AAB6C5" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <ComboBox Width="132" ItemsSource="{Binding ViewportRenderStyles}" SelectedItem="{Binding WorldViewportRenderStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ViewportTitle}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text=" · " Foreground="#718096" />
                            <TextBlock Text="{Binding ViewportSummary}" Foreground="#AAB6C5" MaxWidth="430" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text=" · " Foreground="#718096" />
                            <TextBlock Text="{Binding ViewportBackendLabel}" Foreground="#78C8FF" FontWeight="SemiBold" />
                            <TextBlock Text=" · " Foreground="#718096" />
                            <TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <local:RekallAgeVulkanViewportHost x:Name="SceneVulkanViewportHost"
                            Cursor="Cross" ToolTip="Select scene entities directly through the Vulkan viewport." />
                        <StackPanel x:Name="NoProjectViewportPlaceholder"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="REKALL AGE" Foreground="{StaticResource Accent}" FontSize="28"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Build a game by describing it, or open an existing project."
                                       Foreground="#AAB6C5" FontSize="15" Margin="0,9,0,16"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Create a project..." Click="OnCreateProjectClick" Padding="18,8" />
                                <Button Content="Open a project..." Click="OnOpenProjectClick" Padding="18,8" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="You can also choose a ready-to-run project from the Examples menu."
                                       Foreground="#718096" Margin="0,14,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="VulkanUnavailablePlaceholder"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="AGE" Foreground="#33404D" FontSize="34" FontWeight="Light" HorizontalAlignment="Center" />
                            <TextBlock Text="Vulkan is unavailable" Foreground="#E28A8A" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding ViewportUnavailableReason}" Foreground="#8796A8" Margin="0,4,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="540" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="WorldTransformStrip" Grid.Row="2" Background="#E3151920" BorderBrush="#394451" BorderThickness="1,1,0,0" Padding="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Transform" Foreground="#9FB0C4" VerticalAlignment="Center" Margin="3,0,5,0" />
                            <ComboBox Width="76" ItemsSource="{Binding TransformTools}" SelectedItem="{Binding TransformTool}" />
                            <ComboBox Width="70" Margin="5,0,0,0" ItemsSource="{Binding TransformSpaces}" SelectedItem="{Binding TransformSpace}" />
                            <TextBlock Text="Move" Foreground="#9FB0C4" VerticalAlignment="Center" Margin="8,0,4,0" />
                            <TextBox x:Name="MoveSnapEditor" MinWidth="72" Padding="8,4"
                                     AutomationProperties.Name="Move snap distance"
                                     HorizontalContentAlignment="Right"
                                     Text="{Binding MoveSnap, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="°" Foreground="#9FB0C4" VerticalAlignment="Center" Margin="8,0,4,0" />
                            <TextBox x:Name="RotationSnapEditor" MinWidth="72" Padding="8,4"
                                     AutomationProperties.Name="Rotation snap angle"
                                     HorizontalContentAlignment="Right"
                                     Text="{Binding RotationSnap, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Scale" Foreground="#9FB0C4" VerticalAlignment="Center" Margin="8,0,4,0" />
                            <TextBox x:Name="ScaleSnapEditor" MinWidth="72" Padding="8,4"
                                     AutomationProperties.Name="Scale snap increment"
                                     HorizontalContentAlignment="Right"
                                     Text="{Binding ScaleSnap, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="InspectorPanel" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Margin="8" Padding="0"
                    Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource EditorHeader}" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="INSPECTOR" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding InspectorSelectionName}" FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding InspectorSelectionId}" Foreground="{StaticResource MutedText}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="10" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding InspectorSelectionId}" />
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="10" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                    Padding="9,3" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="{Binding InspectorComponentCountText}" Foreground="{StaticResource Accent}" FontSize="11" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="10,9,10,7">
                        <TextBox x:Name="InspectorSearchBox"
                                 Text="{Binding InspectorSearchInput, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search attached components"
                                 Padding="9,5" />
                        <TextBlock Text="Search components and values…" Foreground="#68798C" Margin="11,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InspectorSearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="2" Margin="10,0,10,8">
                        <ListBox x:Name="InspectorComponentList"
                                 ItemsSource="{Binding InspectorComponentEditors}"
                                 SelectedValue="{Binding SelectedInspectorComponent, Mode=TwoWay}"
                                 SelectedValuePath="Component"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Padding="0" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#354354" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" CornerRadius="8" Background="#233140" Padding="7,2" Margin="6,0,0,0">
                                                    <TextBlock FontSize="9" Foreground="#AFC2D8">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="REGISTERED" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SchemaKnown}" Value="False">
                                                                        <Setter Property="Text" Value="CUSTOM" />
                                                                        <Setter Property="Foreground" Value="#F2B36F" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Type}" FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                                       Foreground="{StaticResource Accent}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedText}"
                                                       TextWrapping="Wrap" FontSize="10" Margin="0,4,0,5" />
                                            <ItemsControl ItemsSource="{Binding PropertyEditors}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#2E3A49" BorderThickness="0,1,0,0" Padding="0,6,0,4">
                                                            <StackPanel ToolTip="{Binding Description}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Margin="0,2,7,0">
                                                                        <TextBlock Text="{Binding Name}" Foreground="#B9C7D6" TextTrimming="CharacterEllipsis" />
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="UNSET" Foreground="#F2B36F" FontSize="9" Margin="0,0,5,0">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers><DataTrigger Binding="{Binding IsDefined}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock Text="{Binding TypeName}" Foreground="#71859B" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <ContentControl Grid.Column="1" Content="{Binding}"
                                                                                    ContentTemplateSelector="{StaticResource InspectorEditorTemplateSelector}" />
                                                                    <Button Grid.Column="2" ToolTip="Reset this property to unset" AutomationProperties.Name="Reset property to unset"
                                                                            Command="{Binding DataContext.ResetInspectorPropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Padding="6,2" Margin="5,0,0,0" VerticalAlignment="Top">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers><DataTrigger Binding="{Binding IsDefined}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                        <Path Data="{StaticResource IconReset}" Style="{StaticResource StudioIconPath}" Margin="0" Width="13" Height="13" />
                                                                    </Button>
                                                                </Grid>
                                                                <TextBlock Text="{Binding ValidationMessage}" Foreground="#FF8A8A" FontSize="10"
                                                                           TextWrapping="Wrap" Margin="112,3,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers><DataTrigger Binding="{Binding ValidationMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding InspectorComponentBrowserEmptyText}" Foreground="{StaticResource MutedText}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="24" TextAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=InspectorComponentList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="3" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0"
                            Background="#171E27" Padding="11,9">
                        <StackPanel>
                            <TextBlock Text="COMPONENTS &amp; ADVANCED JSON" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding SelectedInspectorComponentDescription}" Foreground="{StaticResource MutedText}"
                                       TextWrapping="Wrap" FontSize="10" Margin="0,4,0,7" MaxHeight="42" />
                            <ComboBox ItemsSource="{Binding ComponentSchemas}" DisplayMemberPath="DisplayName" SelectedValuePath="Type"
                                      SelectedValue="{Binding ComponentTypeInput, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" TextSearch.TextPath="Type" Margin="0,0,0,5" />
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <Button Content="Add / Replace" Command="{Binding AddComponentCommand}" Padding="8,4" Margin="0,0,3,0" />
                                <Button Content="Remove Component" Command="{Binding RemoveComponentCommand}" Padding="8,4" Margin="3,0,0,0" />
                            </UniformGrid>
                            <Expander Header="Add custom JSON property" IsExpanded="False">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="Attached properties are edited above. Use this fallback only for a new custom property or raw JSON shape."
                                               Foreground="#91A3B7" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,6" />
                                    <TextBlock Text="PROPERTY NAME" Style="{StaticResource SectionLabel}" />
                                    <TextBox Text="{Binding PropertyNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,5" />
                                    <TextBlock Text="JSON VALUE" Style="{StaticResource SectionLabel}" />
                                    <TextBox Text="{Binding PropertyValueInput, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Mono, Consolas" AcceptsReturn="True" MinHeight="48"
                                             VerticalScrollBarVisibility="Auto" Margin="0,3,0,5" />
                                    <UniformGrid Columns="2">
                                        <Button Content="Set custom JSON" Command="{Binding SetPropertyCommand}" Style="{StaticResource AccentButton}"
                                                Padding="8,4" Margin="0,0,3,0" />
                                        <Button Content="Remove custom property" Command="{Binding RemovePropertyCommand}" Padding="8,4" Margin="3,0,0,0" />
                                    </UniformGrid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TabControl x:Name="OutputTabs" Grid.Column="1" Grid.Row="1" Margin="0,0,0,8">
                <TabItem Header="Modeling" Visibility="Collapsed">
                    <TabControl>
                    <TabItem Header="Mesh Edit">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Mesh asset" Foreground="#9FB0C4" />
                            <ComboBox ItemsSource="{Binding MeshAssetIds}" SelectedItem="{Binding SelectedMeshAssetId}" Margin="0,3,0,5" />
                            <UniformGrid Columns="2">
                                <Button Content="Refresh" Command="{Binding RefreshMeshAssetsCommand}" Padding="7,3" Margin="0,0,3,0" />
                                <Button Content="Open" Command="{Binding OpenMeshAssetCommand}" Padding="7,3" Margin="3,0,0,0" />
                            </UniformGrid>
                            <TextBlock Text="Edit domain" Foreground="#9FB0C4" Margin="0,9,0,0" />
                            <ComboBox ItemsSource="{Binding MeshEditDomains}" SelectedItem="{Binding MeshEditDomain}" Margin="0,3,0,5" />
                            <TextBlock Text="Stable element ID" Foreground="#9FB0C4" />
                            <ComboBox ItemsSource="{Binding MeshElementIds}" SelectedItem="{Binding SelectedMeshElementId}" Margin="0,3,0,5" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Extend" IsChecked="{Binding ExtendMeshSelection}" Margin="0,0,12,0" />
                                <CheckBox Content="Toggle" IsChecked="{Binding ToggleMeshSelection}" />
                            </StackPanel>
                            <UniformGrid Columns="2" Margin="0,5,0,0">
                                <Button Content="Select" Command="{Binding SelectMeshElementCommand}" Padding="7,3" Margin="0,0,3,0" />
                                <Button Content="Clear" Command="{Binding ClearMeshSelectionCommand}" Padding="7,3" Margin="3,0,0,0" />
                            </UniformGrid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Semantic operation" Foreground="#9FB0C4" />
                            <ComboBox ItemsSource="{Binding MeshOperationIds}" SelectedItem="{Binding SelectedMeshOperationId}" Margin="0,3,0,5" />
                            <TextBlock Text="Typed parameters" Foreground="#9FB0C4" />
                            <ScrollViewer Height="72" VerticalScrollBarVisibility="Auto" Margin="0,3,0,5">
                                <ItemsControl ItemsSource="{Binding MeshParameterEditors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4" ToolTip="{Binding Description}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock FontSize="10" Foreground="#75869A"><Run Text="{Binding TypeLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding RequirementLabel, Mode=OneWay}" /></TextBlock>
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <UniformGrid Columns="3">
                                <Button Content="Preview" Command="{Binding PreviewMeshOperationCommand}" Padding="7,3" Margin="0,0,3,0" />
                                <Button Content="Apply" Command="{Binding ApplyMeshOperationCommand}" Style="{StaticResource AccentButton}" Padding="7,3" Margin="3,0" />
                                <Button Content="Cancel" Command="{Binding CancelMeshPreviewCommand}" Padding="7,3" Margin="3,0,0,0" />
                            </UniformGrid>
                            <TextBlock Text="{Binding MeshSummary}" TextWrapping="Wrap" Foreground="#AAB6C5" Margin="0,9,0,0" />
                        </StackPanel>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="140" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Background="#0C1016" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Margin="0,0,0,6">
                                <Image Source="{Binding MeshViewportImage}" Stretch="Fill" MouseLeftButtonDown="OnMeshViewportMouseDown" MouseMove="OnMeshViewportMouseMove" MouseLeftButtonUp="OnMeshViewportMouseUp" LostMouseCapture="OnMeshViewportLostMouseCapture" Cursor="Cross" ToolTip="Click visible geometry to select it. In Point mode, drag the colored X/Y/Z handles to move the selection. Shift extends; Ctrl toggles." />
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <DockPanel Margin="0,0,5,0">
                                    <TextBlock DockPanel.Dock="Top" Text="Selection history" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ListBox ItemsSource="{Binding MeshSelectionLines}" />
                                </DockPanel>
                                <DockPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock DockPanel.Dock="Top" Text="Evaluation diagnostics" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ListBox ItemsSource="{Binding MeshDiagnosticLines}" />
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                    </TabItem>
                    <TabItem Header="Procedural Graph">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource EditorPanel}" Margin="0,0,8,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}">
                                        <TextBlock Text="PROCEDURAL GRAPH" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Graph asset" Style="{StaticResource SectionLabel}" />
                                        <ComboBox ItemsSource="{Binding ModelingGraphAssetIds}" SelectedItem="{Binding SelectedModelingGraphAssetId}" Margin="0,3,0,6" />
                                        <UniformGrid Columns="2">
                                            <Button Content="Refresh" Command="{Binding RefreshModelingGraphsCommand}" Padding="7,3" Margin="0,0,3,0" />
                                            <Button Content="Open" Command="{Binding OpenModelingGraphCommand}" Padding="7,3" Margin="3,0,0,0" />
                                        </UniformGrid>
                                        <TextBlock Text="Named output" Style="{StaticResource SectionLabel}" Margin="0,12,0,0" />
                                        <ComboBox ItemsSource="{Binding ModelingGraphOutputNames}" SelectedItem="{Binding SelectedModelingGraphOutput}" Margin="0,3,0,6" />
                                        <Button Content="Evaluate Output" Command="{Binding EvaluateModelingGraphCommand}" Style="{StaticResource AccentButton}" />
                                        <TextBlock Text="{Binding ModelingGraphSummary}" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource EditorPanel}" Margin="0,0,8,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}">
                                        <TextBlock Text="NODE CONTRACTS" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                    <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <ListBox ItemsSource="{Binding ModelingGraphNodes}" SelectedItem="{Binding SelectedModelingGraphNode}" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="7">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Foreground="{StaticResource Accent}" FontSize="10"><Run Text="{Binding IncomingLinkCount, Mode=OneWay}" /><Run Text=" IN · " /><Run Text="{Binding OutgoingLinkCount, Mode=OneWay}" /><Run Text=" OUT" /></TextBlock>
                                                        </Grid>
                                                        <TextBlock Text="{Binding NodeId}" Foreground="{StaticResource MutedText}" FontSize="10" />
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,3" />
                                                        <ItemsControl ItemsSource="{Binding Parameters}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,1">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource Accent}" FontFamily="Cascadia Mono, Consolas" FontSize="10" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0"><Run Text="cache: " /><Run Text="{Binding LastEvaluation.CacheHit, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LastEvaluation.DurationMilliseconds, Mode=OneWay, StringFormat={}{0:F2} ms}" /></TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border Grid.Row="1" Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="TYPED PARAMETERS" Style="{StaticResource SectionLabel}" />
                                            <ScrollViewer MaxHeight="112" VerticalScrollBarVisibility="Auto" Margin="0,5,0,5">
                                                <ItemsControl ItemsSource="{Binding ModelingGraphParameterEditors}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,5" ToolTip="{Binding Description}">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11" />
                                                                    <TextBlock Foreground="{StaticResource MutedText}" FontSize="9"><Run Text="{Binding TypeLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Unit, Mode=OneWay}" /></TextBlock>
                                                                </StackPanel>
                                                                <ComboBox Grid.Column="1" ItemsSource="{Binding EnumChoices}" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Padding="5,2" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <Button Content="Apply Parameters + Re-evaluate" Command="{Binding ApplyModelingGraphParametersCommand}" Style="{StaticResource AccentButton}" Padding="7,3" />
                                        </StackPanel>
                                    </Border>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="100" /></Grid.RowDefinitions>
                                <Border Style="{StaticResource EditorPanel}" Background="{StaticResource ViewportBackground}" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}">
                                            <TextBlock Text="EVALUATED OUTPUT" FontWeight="SemiBold" FontSize="11" />
                                        </Border>
                                        <Image Source="{Binding ModelingGraphViewportImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource EditorPanel}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}">
                                            <TextBlock Text="DIAGNOSTICS" FontWeight="SemiBold" FontSize="11" />
                                        </Border>
                                        <ListBox ItemsSource="{Binding ModelingGraphDiagnosticLines}" BorderThickness="0" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>
                    </TabControl>
                </TabItem>
                <TabItem Header="Validation"><ListBox ItemsSource="{Binding ValidationLines}" /></TabItem>
                <TabItem x:Name="ContentBrowserPanel" Header="Content Browser">
                    <local:ContentBrowser x:Name="ContentBrowserHost" />
                </TabItem>
                <TabItem Header="Overview"><ListBox ItemsSource="{Binding SceneSummaryLines}" /></TabItem>
                <TabItem Header="Actions"><ListBox ItemsSource="{Binding ActionLines}" /></TabItem>
                <TabItem Header="Rendering">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="285" />
                            <ColumnDefinition Width="390" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource EditorPanel}" Margin="0,0,8,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}">
                                    <TextBlock Text="AUTHORED QUALITY" FontWeight="SemiBold" FontSize="11" />
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Preset" Style="{StaticResource SectionLabel}" />
                                        <ComboBox ItemsSource="{Binding QualityPresets}"
                                                  SelectedItem="{Binding SelectedQualityPreset, Mode=TwoWay}"
                                                  Margin="0,3,0,6" ToolTip="Authored requested preset; the resolved preset is reported separately." />
                                        <UniformGrid Columns="2" Margin="0,0,0,8">
                                            <Button Content="Attach to Selected" Command="{Binding AttachQualityProfileCommand}" Padding="7,3" Margin="0,0,3,0" />
                                            <Button Content="Apply" Command="{Binding ApplyQualityCommand}" Style="{StaticResource AccentButton}" Padding="7,3" Margin="3,0,0,0" />
                                        </UniformGrid>
                                        <Expander Header="Feature overrides" IsExpanded="False" Margin="0,2,0,8">
                                            <Grid Margin="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="138" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Resolution scale" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding QualityResolutionScaleInput, UpdateSourceTrigger=PropertyChanged}" Margin="3,2" ToolTip="Blank uses the preset value." />
                                                <TextBlock Grid.Row="1" Text="Shadow cascades" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding QualityShadowCascadeCountInput, UpdateSourceTrigger=PropertyChanged}" Margin="3,2" ToolTip="Blank uses the preset value." />
                                                <TextBlock Grid.Row="2" Text="Shadow resolution" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding QualityShadowResolutionInput, UpdateSourceTrigger=PropertyChanged}" Margin="3,2" ToolTip="Blank uses the preset value." />
                                                <TextBlock Grid.Row="3" Text="Fog mode" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
                                                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding QualityFogModes}" Text="{Binding QualityFogModeInput, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="3,2" ToolTip="Blank uses the preset value; unsupported values remain inspectable degradations." />
                                                <TextBlock Grid.Row="4" Text="Bloom" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
                                                <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding QualityBloomOverride, Mode=TwoWay}" IsThreeState="True" Margin="6,4" ToolTip="Indeterminate uses the preset value." />
                                                <TextBlock Grid.Row="5" Text="SSAO" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
                                                <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding QualitySsaoOverride, Mode=TwoWay}" IsThreeState="True" Margin="6,4" ToolTip="Indeterminate uses the preset value." />
                                                <TextBlock Grid.Row="6" Text="Max particles" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
                                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding QualityMaximumActiveParticlesInput, UpdateSourceTrigger=PropertyChanged}" Margin="3,2" ToolTip="Blank uses the preset value." />
                                            </Grid>
                                        </Expander>
                                        <TextBlock Text="Compare against" Style="{StaticResource SectionLabel}" />
                                        <ComboBox ItemsSource="{Binding QualityPresets}" SelectedItem="{Binding ComparisonQualityPreset, Mode=TwoWay}" Margin="0,3,0,6" />
                                        <UniformGrid Columns="2">
                                            <Button Content="Capture" Command="{Binding CaptureQualityCommand}" Padding="7,3" Margin="0,0,3,0" ToolTip="Capture through rekall.render.capture_runtime_viewport." />
                                            <Button Content="Compare" Command="{Binding CompareQualityCommand}" Padding="7,3" Margin="3,0,0,0" ToolTip="Compare aligned frames through rekall.render.compare_quality_presets." />
                                        </UniformGrid>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource EditorPanel}" Margin="0,0,8,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}">
                                    <TextBlock Text="RESOLVED / RUNTIME" FontWeight="SemiBold" FontSize="11" />
                                </Border>
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Requested" Foreground="{StaticResource MutedText}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RequestedQualityPreset}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Resolved" Foreground="{StaticResource MutedText}" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ResolvedQualityPreset}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="Output" Foreground="{StaticResource MutedText}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OutputResolutionText}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Internal" Foreground="{StaticResource MutedText}" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding InternalResolutionText}" />
                                        <TextBlock Grid.Row="2" Text="Total GPU" Foreground="{StaticResource MutedText}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalGpuMillisecondsText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Workload" Foreground="{StaticResource MutedText}" />
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding RenderWorkloadText}" />
                                    </Grid>
                                    <DockPanel Grid.Row="1" Margin="0,8,0,4">
                                        <TextBlock DockPanel.Dock="Top" Text="PASS TIMINGS" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding GpuTimingStatusText}" Foreground="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        <ListBox ItemsSource="{Binding RenderPassTimings}" BorderThickness="1">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding MillisecondsText}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                    <DockPanel Grid.Row="2" Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Top" Text="RESOURCES" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                                        <ListBox ItemsSource="{Binding RenderResources}" BorderThickness="1">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="135" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Bytes, StringFormat={}{0:N0} bytes}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource EditorPanel}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}">
                                    <TextBlock Text="DIAGNOSTICS / CAPTURES" FontWeight="SemiBold" FontSize="11" />
                                </Border>
                                <Grid Margin="8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="Debug view" Style="{StaticResource SectionLabel}" />
                                        <ComboBox ItemsSource="{Binding RenderDebugViews}" SelectedItem="{Binding SelectedRenderDebugView, Mode=TwoWay}" DisplayMemberPath="Label" Margin="0,3,0,6" ToolTip="Select an exact capture path returned by the renderer." />
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" Margin="0,3">
                                        <TextBlock DockPanel.Dock="Top" Text="DEGRADATIONS" Style="{StaticResource SectionLabel}" />
                                        <ListBox ItemsSource="{Binding RenderDegradations}">
                                            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="#F2B36F" /><TextBlock TextWrapping="Wrap"><Run Text="{Binding Feature}" /><Run Text=": requested=" /><Run Text="{Binding RequestedValue}" /><Run Text=" → resolved=" /><Run Text="{Binding ResolvedValue}" /></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                    <DockPanel Grid.Row="2" Margin="0,3">
                                        <TextBlock DockPanel.Dock="Top" Text="QUALITY COMPARISONS" Style="{StaticResource SectionLabel}" />
                                        <ListBox ItemsSource="{Binding RenderQualityComparisons}">
                                            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock FontWeight="SemiBold"><Run Text="{Binding RequestedPreset}" /><Run Text=" → " /><Run Text="{Binding ResolvedPreset}" /></TextBlock><TextBlock Foreground="{StaticResource MutedText}"><Run Text="{Binding RenderWidth}" /><Run Text="×" /><Run Text="{Binding RenderHeight}" /><Run Text=" · GPU " /><Run Text="{Binding TotalGpuMillisecondsText}" /></TextBlock><TextBlock Text="{Binding ScreenshotPath}" TextTrimming="CharacterEllipsis" FontSize="10" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                    <DockPanel Grid.Row="3" Margin="0,3">
                                        <TextBlock DockPanel.Dock="Top" Text="SUGGESTED ACTIONS" Style="{StaticResource SectionLabel}" />
                                        <ListBox ItemsSource="{Binding RenderSuggestedActions}" FontSize="10" />
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Runtime"><ListBox ItemsSource="{Binding RuntimeObservationLines}" /></TabItem>
                <TabItem Header="Transactions"><ListBox ItemsSource="{Binding TransactionLines}" /></TabItem>
                <TabItem Header="Imports"><ListBox ItemsSource="{Binding ImportLines}" /></TabItem>
                <TabItem Header="Delivery">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Package for" Foreground="#9FB0C4" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                  ItemsSource="{Binding PackageTargets}"
                                  SelectedItem="{Binding SelectedPackageTarget}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Runnable game" Foreground="#9FB0C4" Margin="0,10,8,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LastPackageLaunchPath, Mode=OneWay}" IsReadOnly="True" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Shareable ZIP" Foreground="#9FB0C4" Margin="0,10,8,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LastPackagePath, Mode=OneWay}" IsReadOnly="True" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Output folder" Foreground="#9FB0C4" Margin="0,10,8,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LastPackageOutputDirectory, Mode=OneWay}" IsReadOnly="True" Margin="0,8,0,0" />
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Package Game" Command="{Binding PackageCommand}" Padding="10,5" />
                            <Button Content="Audit Package" Command="{Binding AuditPackageCommand}" Padding="10,5" Margin="8,0,0,0" />
                            <Button Content="Open Package Folder" Command="{Binding OpenPackageFolderCommand}" Padding="10,5" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
            <GridSplitter x:Name="ContentBrowserSplitter" Grid.Column="1" Grid.Row="1"
                          Height="5" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndCurrent" />
            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2">
                <Border Padding="10,6" Margin="8,0,8,6" CornerRadius="5"
                        Background="#332C5364" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLanguageModelSetupIncomplete, ElementName=StudioWindow}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="AI setup incomplete" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{StaticResource WorkbenchText}" />
                        <TextBlock Text=" · " Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <Button Content="Configure" Click="OnLanguageModelSetupClick" MinWidth="76" Padding="9,3"
                                IsEnabled="{Binding CanOpenLanguageModelSetup, ElementName=StudioWindow}" />
                    </WrapPanel>
                </Border>
            <Border x:Name="WorldAuthoringStrip"
                    Margin="8,0,8,8" Padding="9,7" CornerRadius="5"
                    Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="8,3" CornerRadius="10" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,9,0">
                        <TextBlock Text="AI" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11" />
                    </Border>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding AgentActivityText}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding AgentActivityText}" Foreground="{StaticResource MutedText}" />
                        <ProgressBar Grid.Row="1" Height="2" Margin="0,4,0,0" IsIndeterminate="True">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAgentRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </Grid>
                    <Border Grid.Column="2" Width="1" Margin="5,0" Background="{StaticResource PanelBorder}" />
                    <Grid Grid.Column="3">
                        <TextBox Text="{Binding AgentTaskInput, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="World authoring prompt"
                                 ToolTip="Describe the next change, then press Enter to send."
                                 Padding="9,5" VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding RunAgentCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Describe the next game change…" Foreground="#68798C" Margin="11,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AgentTaskInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="4" Content="Send" Command="{Binding RunAgentCommand}"
                            Style="{StaticResource AccentButton}" Padding="13,5" Margin="7,0,0,0" />
                    <Button Grid.Column="5" Content="Cancel" Command="{Binding CancelAgentCommand}"
                            Padding="11,5" Margin="5,0,0,0" />
                </Grid>
            </Border>
            </StackPanel>
            <GridSplitter Grid.Column="0" Grid.RowSpan="2" Width="5" HorizontalAlignment="Right"
                          Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" />
            <GridSplitter Grid.Column="2" Grid.RowSpan="2" Width="5" HorizontalAlignment="Left"
                          Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent" />
            <GridSplitter Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Height="5" VerticalAlignment="Top"
                          Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndCurrent" />
            </Grid>
            <local:ModelingWorkspace x:Name="ModelingWorkspaceHost" Grid.Row="1" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
