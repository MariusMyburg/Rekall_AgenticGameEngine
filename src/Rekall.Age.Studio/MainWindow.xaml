<Window x:Class="Rekall.Age.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rekall AGE Studio" Width="1500" Height="940" MinWidth="1120" MinHeight="700"
        Background="{StaticResource WorkbenchBackground}" Foreground="{StaticResource WorkbenchText}"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBackground}" Padding="12,9" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Project" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding ProjectPathInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="Name" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="3" Text="{Binding ProjectNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="4" Text="Scene" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="5" ItemsSource="{Binding SceneNames}" SelectedItem="{Binding SceneNameInput}"
                          IsEditable="True" />
                <Button Grid.Column="6" Content="Switch" Command="{Binding SwitchSceneCommand}" Padding="8,2" Margin="6,0" />
                <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border CornerRadius="10" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="9,3" Margin="8,0">
                        <TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11" />
                    </Border>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextAlignment="Right"
                               Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" MaxWidth="440" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Padding="7" Background="{StaticResource ChromeBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal">
            <Button Content="Create" Command="{Binding CreateCommand}" ToolTip="Create a new AGE project" />
            <Button Content="Open" Command="{Binding OpenCommand}" ToolTip="Open the selected project" />
            <Border Width="1" Margin="7,4" Background="{StaticResource PanelBorder}" />
            <Button Content="Undo" Command="{Binding UndoCommand}" />
            <Button Content="Redo" Command="{Binding RedoCommand}" />
            <Border Width="1" Margin="7,4" Background="{StaticResource PanelBorder}" />
            <Button Content="Add Entity" Command="{Binding AddEntityCommand}" />
            <Border Width="1" Margin="7,4" Background="{StaticResource PanelBorder}" />
            <Button Content="Simulate" Command="{Binding SimulateCommand}" Style="{StaticResource AccentButton}" ToolTip="Run the scene in this viewport without changing authored state" />
            <Button Content="Play" Command="{Binding PlayCommand}" ToolTip="Launch the game in the production Player" />
            <Button Content="Stop" Command="{Binding StopCommand}" ToolTip="Stop Simulate or Play and return to Edit" />
            <ToggleButton Content="Live" IsChecked="{Binding IsLiveViewportEnabled, Mode=TwoWay}" Margin="7,2,2,2" ToolTip="Continuously update the viewport while simulating" />
            <Border Width="1" Margin="7,4" Background="{StaticResource PanelBorder}" />
            <Button Content="Capture" Command="{Binding CaptureCommand}" />
            <Button Content="Validate" Command="{Binding ValidateCommand}" />
            <Border Width="1" Margin="7,4" Background="{StaticResource PanelBorder}" />
            <Button Content="Package" Command="{Binding PackageCommand}" />
            <Button Content="Audit Package" Command="{Binding AuditPackageCommand}" />
          </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" /><ColumnDefinition Width="*" /><ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="260" /></Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="8" Padding="8"
                    Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Scene Hierarchy" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TreeView ItemsSource="{Binding EntityNodes}" SelectedItemChanged="OnSelectedEntityChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}" /></HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Grid.Row="0" Margin="0,8,0,8" Background="#090C10"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                <Grid>
                    <Image Source="{Binding ViewportImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="AGE" Foreground="#33404D" FontSize="34" FontWeight="Light" HorizontalAlignment="Center" />
                        <TextBlock Text="Open a project to render the live viewport" Foreground="#607184" Margin="0,8,0,0" />
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ViewportImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    </StackPanel>
                    <Border VerticalAlignment="Top" Background="#D9171C23" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ViewportTitle}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text=" · " Foreground="#718096" />
                            <TextBlock Text="{Binding ViewportSummary}" Foreground="#AAB6C5" />
                            <TextBlock Text=" · " Foreground="#718096" />
                            <TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Grid.Row="0" Margin="8" Padding="8"
                    Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Inspector" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="Component type" Foreground="#9FB0C4" />
                        <ComboBox ItemsSource="{Binding ComponentSchemas}" DisplayMemberPath="DisplayName" SelectedValuePath="Type"
                                  SelectedValue="{Binding ComponentTypeInput, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" TextSearch.TextPath="Type" Margin="0,3,0,6" />
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Content="Add / Replace" Command="{Binding AddComponentCommand}" Padding="8,4" Margin="0,0,3,0" />
                            <Button Content="Remove" Command="{Binding RemoveComponentCommand}" Padding="8,4" Margin="3,0,0,0" />
                        </UniformGrid>
                        <TextBlock Text="Property name" Foreground="#9FB0C4" />
                        <ComboBox ItemsSource="{Binding PropertySchemas}" DisplayMemberPath="Name" SelectedValuePath="Name"
                                  SelectedValue="{Binding PropertyNameInput, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Margin="0,3,0,4" />
                        <TextBlock Text="{Binding PropertySchemaHelp}" Foreground="#9FB0C4" TextWrapping="Wrap" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding PropertyValueChoices}"
                                  Text="{Binding PropertyValueInput, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Margin="0,3,0,6" />
                        <UniformGrid Columns="2">
                            <Button Content="Set" Command="{Binding SetPropertyCommand}" Padding="8,4" Margin="0,0,3,0" />
                            <Button Content="Remove" Command="{Binding RemovePropertyCommand}" Padding="8,4" Margin="3,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding InspectorLines}" />
                </DockPanel>
            </Border>

            <TabControl Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,0,8,8">
                <TabItem Header="Modeling">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Mesh asset" Foreground="#9FB0C4" />
                            <ComboBox ItemsSource="{Binding MeshAssetIds}" SelectedItem="{Binding SelectedMeshAssetId}" Margin="0,3,0,5" />
                            <UniformGrid Columns="2">
                                <Button Content="Refresh" Command="{Binding RefreshMeshAssetsCommand}" Padding="7,3" Margin="0,0,3,0" />
                                <Button Content="Open" Command="{Binding OpenMeshAssetCommand}" Padding="7,3" Margin="3,0,0,0" />
                            </UniformGrid>
                            <TextBlock Text="Edit domain" Foreground="#9FB0C4" Margin="0,9,0,0" />
                            <ComboBox ItemsSource="{Binding MeshEditDomains}" SelectedItem="{Binding MeshEditDomain}" Margin="0,3,0,5" />
                            <TextBlock Text="Stable element ID" Foreground="#9FB0C4" />
                            <ComboBox ItemsSource="{Binding MeshElementIds}" SelectedItem="{Binding SelectedMeshElementId}" Margin="0,3,0,5" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Extend" IsChecked="{Binding ExtendMeshSelection}" Margin="0,0,12,0" />
                                <CheckBox Content="Toggle" IsChecked="{Binding ToggleMeshSelection}" />
                            </StackPanel>
                            <UniformGrid Columns="2" Margin="0,5,0,0">
                                <Button Content="Select" Command="{Binding SelectMeshElementCommand}" Padding="7,3" Margin="0,0,3,0" />
                                <Button Content="Clear" Command="{Binding ClearMeshSelectionCommand}" Padding="7,3" Margin="3,0,0,0" />
                            </UniformGrid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Semantic operation" Foreground="#9FB0C4" />
                            <ComboBox ItemsSource="{Binding MeshOperationIds}" SelectedItem="{Binding SelectedMeshOperationId}" Margin="0,3,0,5" />
                            <TextBlock Text="Typed parameters" Foreground="#9FB0C4" />
                            <ScrollViewer Height="72" VerticalScrollBarVisibility="Auto" Margin="0,3,0,5">
                                <ItemsControl ItemsSource="{Binding MeshParameterEditors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4" ToolTip="{Binding Description}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock FontSize="10" Foreground="#75869A"><Run Text="{Binding TypeLabel}" /><Run Text=" · " /><Run Text="{Binding RequirementLabel}" /></TextBlock>
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <UniformGrid Columns="3">
                                <Button Content="Preview" Command="{Binding PreviewMeshOperationCommand}" Padding="7,3" Margin="0,0,3,0" />
                                <Button Content="Apply" Command="{Binding ApplyMeshOperationCommand}" Style="{StaticResource AccentButton}" Padding="7,3" Margin="3,0" />
                                <Button Content="Cancel" Command="{Binding CancelMeshPreviewCommand}" Padding="7,3" Margin="3,0,0,0" />
                            </UniformGrid>
                            <TextBlock Text="{Binding MeshSummary}" TextWrapping="Wrap" Foreground="#AAB6C5" Margin="0,9,0,0" />
                        </StackPanel>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="140" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Background="#0C1016" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Margin="0,0,0,6">
                                <Image Source="{Binding MeshViewportImage}" Stretch="Fill" MouseLeftButtonDown="OnMeshViewportMouseDown" MouseMove="OnMeshViewportMouseMove" MouseLeftButtonUp="OnMeshViewportMouseUp" LostMouseCapture="OnMeshViewportLostMouseCapture" Cursor="Cross" ToolTip="Click visible geometry to select it. In Point mode, drag the colored X/Y/Z handles to move the selection. Shift extends; Ctrl toggles." />
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <DockPanel Margin="0,0,5,0">
                                    <TextBlock DockPanel.Dock="Top" Text="Selection history" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ListBox ItemsSource="{Binding MeshSelectionLines}" />
                                </DockPanel>
                                <DockPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock DockPanel.Dock="Top" Text="Evaluation diagnostics" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ListBox ItemsSource="{Binding MeshDiagnosticLines}" />
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Validation"><ListBox ItemsSource="{Binding ValidationLines}" /></TabItem>
                <TabItem Header="Assets"><ListBox ItemsSource="{Binding AssetLines}" /></TabItem>
                <TabItem Header="Overview"><ListBox ItemsSource="{Binding SceneSummaryLines}" /></TabItem>
                <TabItem Header="Actions"><ListBox ItemsSource="{Binding ActionLines}" /></TabItem>
                <TabItem Header="Runtime"><ListBox ItemsSource="{Binding RuntimeObservationLines}" /></TabItem>
                <TabItem Header="Transactions"><ListBox ItemsSource="{Binding TransactionLines}" /></TabItem>
                <TabItem Header="Imports"><ListBox ItemsSource="{Binding ImportLines}" /></TabItem>
                <TabItem Header="AI Agent">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Local Ollama model" Foreground="#9FB0C4" />
                            <ComboBox ItemsSource="{Binding OllamaModels}" SelectedItem="{Binding SelectedOllamaModel}"
                                      IsEditable="True" Margin="0,3,0,6" />
                            <Button Content="Discover Models" Command="{Binding DiscoverModelsCommand}" Padding="8,4" Margin="0,0,0,8" />
                            <TextBlock Text="Game-authoring task" Foreground="#9FB0C4" />
                            <Grid Height="86" Margin="0,3,0,6">
                                <TextBox Text="{Binding AgentTaskInput, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Padding="4" />
                                <TextBlock Text="Describe the game you want in ordinary language. AGE handles tools, implementation, testing, and delivery."
                                           Foreground="#75869A" Margin="8,6" TextWrapping="Wrap" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AgentTaskInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <UniformGrid Columns="2">
                                <Button Content="Run Agent" Command="{Binding RunAgentCommand}" Padding="8,4" Margin="0,0,3,0" />
                                <Button Content="Cancel" Command="{Binding CancelAgentCommand}" Padding="8,4" Margin="3,0,0,0" />
                            </UniformGrid>
                        </StackPanel>
                        <ListBox Grid.Column="1" ItemsSource="{Binding AgentLines}" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
