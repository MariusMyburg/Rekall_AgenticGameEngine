<UserControl x:Class="Rekall.Age.Studio.ModelingWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WorkbenchBackground}">
    <UserControl.Resources>
        <DrawingBrush x:Key="ModelingGrid" TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#30343A" Geometry="M 0,0 L 40,0 M 0,0 L 0,40">
                    <GeometryDrawing.Pen><Pen Brush="#4A5058" Thickness="0.6" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="#161B22" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MODELING" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <Border Width="1" Margin="12,2" Background="{StaticResource PanelBorder}" />
                    <Button Content="Refresh Meshes" Command="{Binding RefreshMeshAssetsCommand}" />
                    <Button Content="Refresh Graphs" Command="{Binding RefreshModelingGraphsCommand}" />
                    <TextBlock Text="Dedicated geometry, topology, materials and procedural authoring workspace"
                               Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Text="Rekall AGE" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#647385" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="{StaticResource WorkbenchBackground}" BorderThickness="0">
            <TabItem Header="Mesh Editing">
                <Grid Margin="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>

                    <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#252A30" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="5,3">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="115" ItemsSource="{Binding MeshEditDomains}" SelectedItem="{Binding MeshEditDomain}" />
                            <TextBlock Text="Add" VerticalAlignment="Center" Margin="12,0,5,0" Foreground="#D0D5DA" />
                            <ComboBox Width="95" ItemsSource="{Binding MeshPrimitiveTypes}" SelectedItem="{Binding SelectedMeshPrimitive}" />
                            <TextBox Width="110" Margin="4,0" Text="{Binding MeshPrimitiveAssetIdInput, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="+ Add" Width="58" Padding="3,1" Command="{Binding CreateMeshPrimitiveCommand}" Style="{StaticResource AccentButton}" />
                            <Border Width="1" Margin="8,2" Background="{StaticResource PanelBorder}" />
                            <TextBlock Text="Edit" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#D0D5DA" />
                            <ComboBox Width="155" ItemsSource="{Binding MeshOperationIds}" SelectedItem="{Binding SelectedMeshOperationId}" />
                            <Button Content="Preview" Width="62" Padding="3,1" Command="{Binding PreviewMeshOperationCommand}" Margin="7,0,0,0" />
                            <Button Content="Apply" Width="52" Padding="3,1" Command="{Binding ApplyMeshOperationCommand}" Style="{StaticResource AccentButton}" />
                            <Button Content="Cancel" Width="55" Padding="3,1" Command="{Binding CancelMeshPreviewCommand}" />
                            <Border Width="1" Margin="8,2" Background="{StaticResource PanelBorder}" />
                            <TextBlock Text="Global" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
                            <TextBlock Text="  •  snapping and stable topology IDs" VerticalAlignment="Center" Foreground="#788695" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Background="#20252B" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,1,1">
                        <StackPanel HorizontalAlignment="Center" Margin="0,8">
                            <Button Content="↖" Width="36" Height="36" Command="{Binding SelectMeshElementCommand}" ToolTip="Select stable element" />
                            <Button Content="✥" Width="36" Height="36" Command="{Binding ClearMeshSelectionCommand}" ToolTip="Clear selection" />
                            <Separator Width="30" Margin="0,5" />
                            <Button Content="P" Width="36" Height="36" Command="{Binding PreviewMeshOperationCommand}" ToolTip="Preview semantic operation" />
                            <Button Content="✓" Width="36" Height="36" Command="{Binding ApplyMeshOperationCommand}" ToolTip="Apply semantic operation" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,1" Background="{StaticResource ModelingGrid}">
                        <Grid>
                            <Line X1="0" Y1="0" X2="1" Y2="1" Stretch="Fill" Stroke="#7E3036" StrokeThickness="1" Opacity="0.75" />
                            <Line X1="0" Y1="1" X2="1" Y2="0" Stretch="Fill" Stroke="#3E7541" StrokeThickness="1" Opacity="0.75" />
                            <Image x:Name="MeshViewportImage" Source="{Binding MeshViewportImage}" Stretch="Fill"
                                   MouseLeftButtonDown="OnMeshMouseDown" MouseMove="OnMeshMouseMove"
                                   MouseLeftButtonUp="OnMeshMouseUp" LostMouseCapture="OnMeshLostCapture" Cursor="Cross" />
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                <TextBlock Text="User Perspective" Foreground="#D5D8DC" />
                                <TextBlock Text="{Binding MeshSummary}" Foreground="#AAB2BC" FontSize="11" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" CornerRadius="18" Width="36" Height="36" BorderBrush="#6D7782" BorderThickness="1" Background="#CC282E35">
                                <Grid><TextBlock Text="Z" Foreground="#5DADE2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" /><TextBlock Text="X Y" Foreground="#D96B73" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" /></Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="2" Grid.RowSpan="3" Width="5" Background="{StaticResource PanelBorder}" />
                    <Grid Grid.Column="3" Grid.RowSpan="3">
                        <Grid.RowDefinitions><RowDefinition Height="210" /><RowDefinition Height="5" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource EditorPanel}">
                            <DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><Grid><TextBlock Text="MESH OUTLINER" /><Button Content="↻" HorizontalAlignment="Right" Command="{Binding RefreshMeshAssetsCommand}" /></Grid></Border><ListBox ItemsSource="{Binding MeshAssetIds}" SelectedItem="{Binding SelectedMeshAssetId}" BorderThickness="0" /></DockPanel>
                        </Border>
                        <GridSplitter Grid.Row="1" Height="5" Background="{StaticResource PanelBorder}" />
                        <Border Grid.Row="2" Style="{StaticResource EditorPanel}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="ACTIVE TOOL / MESH PROPERTIES" /></Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="9">
                                        <Button Content="Open Selected Mesh" Command="{Binding OpenMeshAssetCommand}" />
                                        <TextBlock Text="Stable element ID" Style="{StaticResource SectionLabel}" Margin="0,12,0,0" />
                                        <ComboBox ItemsSource="{Binding MeshElementIds}" SelectedItem="{Binding SelectedMeshElementId}" Margin="0,4,0,5" />
                                        <StackPanel Orientation="Horizontal"><CheckBox Content="Extend" IsChecked="{Binding ExtendMeshSelection}" Margin="0,0,14,0" /><CheckBox Content="Toggle" IsChecked="{Binding ToggleMeshSelection}" /></StackPanel>
                                        <UniformGrid Columns="2" Margin="0,5,0,0"><Button Content="Select" Command="{Binding SelectMeshElementCommand}" /><Button Content="Clear" Command="{Binding ClearMeshSelectionCommand}" /></UniformGrid>
                                        <TextBlock Text="Operation parameters" Style="{StaticResource SectionLabel}" Margin="0,14,0,0" />
                                        <ItemsControl ItemsSource="{Binding MeshParameterEditors}" Margin="0,5,0,3"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="115" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" /><TextBox Grid.Column="1" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <Expander Header="Selection History" IsExpanded="True" Margin="0,10,0,0"><ListBox ItemsSource="{Binding MeshSelectionLines}" MaxHeight="110" /></Expander>
                                        <Expander Header="Topology Diagnostics" IsExpanded="True" Margin="0,5,0,0"><ListBox ItemsSource="{Binding MeshDiagnosticLines}" MaxHeight="150" /></Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#20252B" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,1,1" Padding="7,3">
                        <Grid><TextBlock Text="View   Select   Mesh" Foreground="#B9C1CA" /><TextBlock Text="Point/Edge/Face domains · stable IDs · deterministic operations" HorizontalAlignment="Center" Foreground="#778493" /><TextBlock Text="Ready" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" /></Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Procedural Geometry">
                <Grid Margin="7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="5" /><ColumnDefinition Width="380" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource EditorPanel}"><DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="PROCEDURAL GRAPH" FontWeight="SemiBold" /></Border><StackPanel Margin="9"><TextBlock Text="Graph asset" Style="{StaticResource SectionLabel}" /><ComboBox ItemsSource="{Binding ModelingGraphAssetIds}" SelectedItem="{Binding SelectedModelingGraphAssetId}" Margin="0,4,0,6" /><UniformGrid Columns="2"><Button Content="Refresh" Command="{Binding RefreshModelingGraphsCommand}" /><Button Content="Open" Command="{Binding OpenModelingGraphCommand}" /></UniformGrid><TextBlock Text="Named output" Style="{StaticResource SectionLabel}" Margin="0,14,0,0" /><ComboBox ItemsSource="{Binding ModelingGraphOutputNames}" SelectedItem="{Binding SelectedModelingGraphOutput}" Margin="0,4,0,6" /><Button Content="Evaluate Output" Command="{Binding EvaluateModelingGraphCommand}" Style="{StaticResource AccentButton}" /><TextBlock Text="{Binding ModelingGraphSummary}" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Margin="0,14,0,0" /></StackPanel></DockPanel></Border>
                    <GridSplitter Grid.Column="1" Width="5" Background="{StaticResource PanelBorder}" />
                    <Border Grid.Column="2" Style="{StaticResource EditorPanel}"><DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="NODE CONTRACTS" FontWeight="SemiBold" /></Border><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><ListBox ItemsSource="{Binding ModelingGraphNodes}" SelectedItem="{Binding SelectedModelingGraphNode}" DisplayMemberPath="DisplayName" BorderThickness="0" /><StackPanel Grid.Row="1" Margin="9"><TextBlock Text="TYPED PARAMETERS" Style="{StaticResource SectionLabel}" /><ItemsControl ItemsSource="{Binding ModelingGraphParameterEditors}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" /><ComboBox Grid.Column="1" ItemsSource="{Binding EnumChoices}" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Apply Parameters + Re-evaluate" Command="{Binding ApplyModelingGraphParametersCommand}" Style="{StaticResource AccentButton}" Margin="0,7,0,0" /></StackPanel></Grid></DockPanel></Border>
                    <GridSplitter Grid.Column="3" Width="5" Background="{StaticResource PanelBorder}" />
                    <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="150" /></Grid.RowDefinitions><Border Style="{StaticResource EditorPanel}" Background="{StaticResource ViewportBackground}" Margin="0,0,0,6"><DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="EVALUATED OUTPUT" FontWeight="SemiBold" /></Border><Image Source="{Binding ModelingGraphViewportImage}" Stretch="Uniform" /></DockPanel></Border><Border Grid.Row="1" Style="{StaticResource EditorPanel}"><DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="DIAGNOSTICS" /></Border><ListBox ItemsSource="{Binding ModelingGraphDiagnosticLines}" BorderThickness="0" /></DockPanel></Border></Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Materials"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="MATERIAL AUTHORING" FontSize="22" FontWeight="Light" HorizontalAlignment="Center" /><TextBlock Text="Node materials, shader stages, texture slots and live previews use AGE's canonical material contracts." Foreground="{StaticResource MutedText}" Margin="0,10,0,0" /></StackPanel></Grid></TabItem>
            <TabItem Header="UV / Attributes"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="UV &amp; ATTRIBUTE DATA" FontSize="22" FontWeight="Light" HorizontalAlignment="Center" /><TextBlock Text="Inspect and author generic mesh domains, named attributes, UV layers and provenance." Foreground="{StaticResource MutedText}" Margin="0,10,0,0" /></StackPanel></Grid></TabItem>
        </TabControl>
    </Grid>
</UserControl>
