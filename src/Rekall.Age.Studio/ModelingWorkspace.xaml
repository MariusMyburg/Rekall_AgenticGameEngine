<UserControl x:Class="Rekall.Age.Studio.ModelingWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WorkbenchBackground}">
    <UserControl.Resources>
        <DrawingBrush x:Key="ModelingGrid" TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#30343A" Geometry="M 0,0 L 40,0 M 0,0 L 0,40">
                    <GeometryDrawing.Pen><Pen Brush="#4A5058" Thickness="0.6" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="#161B22" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MODELING" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <Border Width="1" Margin="12,2" Background="{StaticResource PanelBorder}" />
                    <Button Content="Refresh Meshes" Command="{Binding RefreshMeshAssetsCommand}" />
                    <Button Content="Refresh Graphs" Command="{Binding RefreshModelingGraphsCommand}" />
                    <TextBlock Text="Dedicated geometry, topology, materials and procedural authoring workspace"
                               Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Text="Rekall AGE" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#647385" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="{StaticResource WorkbenchBackground}" BorderThickness="0">
            <TabItem Header="Mesh Editing">
                <Grid Margin="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>

                    <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#252A30" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="5,3">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="115" ItemsSource="{Binding MeshEditDomains}" SelectedItem="{Binding MeshEditDomain}" />
                            <TextBlock Text="Add" VerticalAlignment="Center" Margin="12,0,5,0" Foreground="#D0D5DA" />
                            <ComboBox Width="95" ItemsSource="{Binding MeshPrimitiveTypes}" SelectedItem="{Binding SelectedMeshPrimitive}" />
                            <TextBox Width="110" Margin="4,0" Text="{Binding MeshPrimitiveAssetIdInput, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="+ Add" Width="58" Padding="3,1" Command="{Binding CreateMeshPrimitiveCommand}" Style="{StaticResource AccentButton}" />
                            <Border Width="1" Margin="8,2" Background="{StaticResource PanelBorder}" />
                            <TextBlock Text="Edit" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#D0D5DA" />
                            <ComboBox Width="155" ItemsSource="{Binding MeshOperationIds}" SelectedItem="{Binding SelectedMeshOperationId}" />
                            <Button Content="Preview" Width="62" Padding="3,1" Command="{Binding PreviewMeshOperationCommand}" Margin="7,0,0,0" />
                            <Button Content="Apply" Width="52" Padding="3,1" Command="{Binding ApplyMeshOperationCommand}" Style="{StaticResource AccentButton}" />
                            <Button Content="Cancel" Width="55" Padding="3,1" Command="{Binding CancelMeshPreviewCommand}" />
                            <Border Width="1" Margin="8,2" Background="{StaticResource PanelBorder}" />
                            <TextBlock Text="Global" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
                            <TextBlock Text="  •  snapping and stable topology IDs" VerticalAlignment="Center" Foreground="#788695" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Background="#20252B" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,1,1">
                        <StackPanel HorizontalAlignment="Center" Margin="0,8">
                            <Button Content="↖" Width="36" Height="36" Command="{Binding SelectMeshElementCommand}" ToolTip="Select stable element" />
                            <Button Content="✥" Width="36" Height="36" Command="{Binding ClearMeshSelectionCommand}" ToolTip="Clear selection" />
                            <Separator Width="30" Margin="0,5" />
                            <Button Content="P" Width="36" Height="36" Command="{Binding PreviewMeshOperationCommand}" ToolTip="Preview semantic operation" />
                            <Button Content="✓" Width="36" Height="36" Command="{Binding ApplyMeshOperationCommand}" ToolTip="Apply semantic operation" />
                            <Separator Width="30" Margin="0,5" />
                            <Button Content="⛶" Width="36" Height="36" Command="{Binding FrameSelectedMeshViewportCommand}" ToolTip="Frame selected (reset pan/zoom)" />
                            <Button Content="⬚/◆" Width="36" Height="36" FontSize="10" Command="{Binding ToggleMeshViewportProjectionCommand}" ToolTip="Toggle orthographic / perspective" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,1" Background="{StaticResource ModelingGrid}">
                        <Grid>
                            <Line X1="0" Y1="0" X2="1" Y2="1" Stretch="Fill" Stroke="#7E3036" StrokeThickness="1" Opacity="0.75" />
                            <Line X1="0" Y1="1" X2="1" Y2="0" Stretch="Fill" Stroke="#3E7541" StrokeThickness="1" Opacity="0.75" />
                            <Image x:Name="MeshViewportImage" Source="{Binding MeshViewportImage}" Stretch="Fill"
                                   MouseLeftButtonDown="OnMeshMouseDown" MouseMove="OnMeshMouseMove"
                                   MouseLeftButtonUp="OnMeshMouseUp" LostMouseCapture="OnMeshLostCapture" Cursor="Cross" />
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                <TextBlock Text="User Perspective" Foreground="#D5D8DC" />
                                <TextBlock Text="{Binding MeshSummary}" Foreground="#AAB2BC" FontSize="11" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" CornerRadius="18" Width="36" Height="36" BorderBrush="#6D7782" BorderThickness="1" Background="#CC282E35">
                                <Grid><TextBlock Text="Z" Foreground="#5DADE2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" /><TextBlock Text="X Y" Foreground="#D96B73" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" /></Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="2" Grid.RowSpan="3" Width="5" Background="{StaticResource PanelBorder}" />
                    <Grid Grid.Column="3" Grid.RowSpan="3">
                        <Grid.RowDefinitions><RowDefinition Height="210" /><RowDefinition Height="5" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource EditorPanel}">
                            <DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><Grid><TextBlock Text="MESH OUTLINER" /><Button Content="↻" HorizontalAlignment="Right" Command="{Binding RefreshMeshAssetsCommand}" /></Grid></Border><ListBox ItemsSource="{Binding MeshAssetIds}" SelectedItem="{Binding SelectedMeshAssetId}" BorderThickness="0" /></DockPanel>
                        </Border>
                        <GridSplitter Grid.Row="1" Height="5" Background="{StaticResource PanelBorder}" />
                        <Border Grid.Row="2" Style="{StaticResource EditorPanel}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="ACTIVE TOOL / MESH PROPERTIES" /></Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="9">
                                        <Button Content="Open Selected Mesh" Command="{Binding OpenMeshAssetCommand}" />
                                        <Expander Header="PUBLISH &amp; PLACE IN SCENE" IsExpanded="True" Margin="0,10,0,0">
                                            <StackPanel Margin="0,6,0,0">
                                                <TextBlock Text="Turn this editable mesh into a reusable Model Asset, then place a live-linked instance in the active scene."
                                                           TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Margin="0,0,0,7" />
                                                <TextBlock Text="Model Asset ID" Style="{StaticResource SectionLabel}" />
                                                <TextBox x:Name="ModelAssetIdInput" Text="{Binding ModelAssetIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,5" />
                                                <TextBlock Text="Display name" Style="{StaticResource SectionLabel}" />
                                                <TextBox Text="{Binding ModelAssetDisplayNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,5" />
                                                <TextBlock Text="Scene entity ID (optional)" Style="{StaticResource SectionLabel}" />
                                                <TextBox Text="{Binding ModelEntityIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,5" />
                                                <TextBlock Text="Scene entity name" Style="{StaticResource SectionLabel}" />
                                                <TextBox Text="{Binding ModelEntityNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,5" />
                                                <TextBlock Text="Optional parent entity ID" Style="{StaticResource SectionLabel}" />
                                                <TextBox Text="{Binding ModelPlacementParentEntityIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,7" />
                                                <TextBlock Text="Position X / Y / Z" Style="{StaticResource SectionLabel}" />
                                                <UniformGrid Columns="3" Margin="0,3,0,5">
                                                    <TextBox x:Name="ModelPositionXInput" Text="{Binding ModelPositionXInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,3,0" />
                                                    <TextBox Text="{Binding ModelPositionYInput, UpdateSourceTrigger=PropertyChanged}" Margin="2,0" />
                                                    <TextBox Text="{Binding ModelPositionZInput, UpdateSourceTrigger=PropertyChanged}" Margin="3,0,0,0" />
                                                </UniformGrid>
                                                <TextBlock Text="Rotation X / Y / Z (degrees)" Style="{StaticResource SectionLabel}" />
                                                <UniformGrid Columns="3" Margin="0,3,0,5">
                                                    <TextBox Text="{Binding ModelRotationXInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,3,0" />
                                                    <TextBox Text="{Binding ModelRotationYInput, UpdateSourceTrigger=PropertyChanged}" Margin="2,0" />
                                                    <TextBox Text="{Binding ModelRotationZInput, UpdateSourceTrigger=PropertyChanged}" Margin="3,0,0,0" />
                                                </UniformGrid>
                                                <TextBlock Text="Scale X / Y / Z" Style="{StaticResource SectionLabel}" />
                                                <UniformGrid Columns="3" Margin="0,3,0,7">
                                                    <TextBox Text="{Binding ModelScaleXInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,3,0" />
                                                    <TextBox Text="{Binding ModelScaleYInput, UpdateSourceTrigger=PropertyChanged}" Margin="2,0" />
                                                    <TextBox Text="{Binding ModelScaleZInput, UpdateSourceTrigger=PropertyChanged}" Margin="3,0,0,0" />
                                                </UniformGrid>
                                                <Button x:Name="PublishAndPlaceModelButton" Content="Publish &amp; Place" Command="{Binding PublishAndPlaceModelCommand}"
                                                        Style="{StaticResource AccentButton}" Padding="7,4" />
                                                <UniformGrid Columns="2" Margin="0,5,0,0">
                                                    <Button x:Name="PublishModelButton" Content="Publish / Rebuild" Command="{Binding PublishModelCommand}" Margin="0,0,3,0" />
                                                    <Button x:Name="PlaceModelButton" Content="Place Another" Command="{Binding PlaceModelCommand}" Margin="3,0,0,0" />
                                                </UniformGrid>
                                                <TextBlock Text="{Binding LastPublishedModelAssetId, StringFormat=Published: {0}, Mode=OneWay}"
                                                           Foreground="{StaticResource MutedText}" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding LastPlacedModelEntityId, StringFormat=Placed entity: {0}, Mode=OneWay}"
                                                           Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock Text="Stable element ID" Style="{StaticResource SectionLabel}" Margin="0,12,0,0" />
                                        <ComboBox ItemsSource="{Binding MeshElementIds}" SelectedItem="{Binding SelectedMeshElementId}" Margin="0,4,0,5" />
                                        <StackPanel Orientation="Horizontal"><CheckBox Content="Extend" IsChecked="{Binding ExtendMeshSelection}" Margin="0,0,14,0" /><CheckBox Content="Toggle" IsChecked="{Binding ToggleMeshSelection}" /></StackPanel>
                                        <UniformGrid Columns="2" Margin="0,5,0,0"><Button Content="Select" Command="{Binding SelectMeshElementCommand}" /><Button Content="Clear" Command="{Binding ClearMeshSelectionCommand}" /></UniformGrid>
                                        <TextBlock Text="Operation parameters" Style="{StaticResource SectionLabel}" Margin="0,14,0,0" />
                                        <ItemsControl ItemsSource="{Binding MeshParameterEditors}" Margin="0,5,0,3"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="115" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" /><TextBox Grid.Column="1" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <Expander Header="Selection History" IsExpanded="True" Margin="0,10,0,0"><ListBox ItemsSource="{Binding MeshSelectionLines}" MaxHeight="110" /></Expander>
                                        <Expander Header="Topology Diagnostics" IsExpanded="True" Margin="0,5,0,0"><ListBox ItemsSource="{Binding MeshDiagnosticLines}" MaxHeight="150" /></Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#20252B" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,1,1" Padding="7,3">
                        <Grid><TextBlock Text="View   Select   Mesh" Foreground="#B9C1CA" /><TextBlock Text="Point/Edge/Face domains · stable IDs · deterministic operations" HorizontalAlignment="Center" Foreground="#778493" /><TextBlock Text="Ready" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" /></Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Procedural Geometry">
                <Grid Margin="7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="5" /><ColumnDefinition Width="380" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource EditorPanel}"><DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="PROCEDURAL GRAPH" FontWeight="SemiBold" /></Border><StackPanel Margin="9"><TextBlock Text="Graph asset" Style="{StaticResource SectionLabel}" /><ComboBox ItemsSource="{Binding ModelingGraphAssetIds}" SelectedItem="{Binding SelectedModelingGraphAssetId}" Margin="0,4,0,6" /><UniformGrid Columns="2"><Button Content="Refresh" Command="{Binding RefreshModelingGraphsCommand}" /><Button Content="Open" Command="{Binding OpenModelingGraphCommand}" /></UniformGrid><TextBlock Text="Named output" Style="{StaticResource SectionLabel}" Margin="0,14,0,0" /><ComboBox ItemsSource="{Binding ModelingGraphOutputNames}" SelectedItem="{Binding SelectedModelingGraphOutput}" Margin="0,4,0,6" /><Button Content="Evaluate Output" Command="{Binding EvaluateModelingGraphCommand}" Style="{StaticResource AccentButton}" /><TextBlock Text="{Binding ModelingGraphSummary}" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Margin="0,14,0,0" /></StackPanel></DockPanel></Border>
                    <GridSplitter Grid.Column="1" Width="5" Background="{StaticResource PanelBorder}" />
                    <Border Grid.Column="2" Style="{StaticResource EditorPanel}"><DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="NODE CONTRACTS" FontWeight="SemiBold" /></Border><Grid><Grid.RowDefinitions><RowDefinition Height="220" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource ViewportBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
                            <Image x:Name="ModelingGraphCanvasImage" Source="{Binding ModelingGraphCanvasImage}" Stretch="Fill" Cursor="Hand"
                                   MouseDown="OnModelingGraphCanvasMouseDown" MouseMove="OnModelingGraphCanvasMouseMove"
                                   MouseUp="OnModelingGraphCanvasMouseUp" LostMouseCapture="OnModelingGraphCanvasLostCapture" />
                        </Border>
                        <ListBox Grid.Row="1" ItemsSource="{Binding ModelingGraphNodes}" SelectedItem="{Binding SelectedModelingGraphNode}" DisplayMemberPath="DisplayName" BorderThickness="0" /><StackPanel Grid.Row="2" Margin="9"><TextBlock Text="TYPED PARAMETERS" Style="{StaticResource SectionLabel}" /><ItemsControl ItemsSource="{Binding ModelingGraphParameterEditors}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" /><ComboBox Grid.Column="1" ItemsSource="{Binding EnumChoices}" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Apply Parameters + Re-evaluate" Command="{Binding ApplyModelingGraphParametersCommand}" Style="{StaticResource AccentButton}" Margin="0,7,0,0" /></StackPanel></Grid></DockPanel></Border>
                    <GridSplitter Grid.Column="3" Width="5" Background="{StaticResource PanelBorder}" />
                    <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="150" /></Grid.RowDefinitions><Border Style="{StaticResource EditorPanel}" Background="{StaticResource ViewportBackground}" Margin="0,0,0,6"><DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="EVALUATED OUTPUT" FontWeight="SemiBold" /></Border><Image Source="{Binding ModelingGraphViewportImage}" Stretch="Uniform" /></DockPanel></Border><Border Grid.Row="1" Style="{StaticResource EditorPanel}"><DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="DIAGNOSTICS" /></Border><ListBox ItemsSource="{Binding ModelingGraphDiagnosticLines}" BorderThickness="0" /></DockPanel></Border></Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Materials">
                <Grid Margin="7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource EditorPanel}"><DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="MATERIAL GRAPH" FontWeight="SemiBold" /></Border><StackPanel Margin="9"><TextBlock Text="Graph asset" Style="{StaticResource SectionLabel}" /><ComboBox ItemsSource="{Binding MaterialGraphAssetIds}" SelectedItem="{Binding SelectedMaterialGraphAssetId}" Margin="0,4,0,6" /><UniformGrid Columns="2"><Button Content="Refresh" Command="{Binding RefreshMaterialGraphsCommand}" /><Button Content="Open" Command="{Binding OpenMaterialGraphCommand}" /></UniformGrid><TextBlock Text="{Binding MaterialGraphSummary}" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Margin="0,14,0,0" /><TextBlock Text="No material-to-pixel preview yet - the engine has no material graph evaluator; editing here is real (persisted through the same revision-safe patch pipeline as procedural geometry) but the result is only visible in the runtime/CLI, not this panel." TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,10,0,0" /></StackPanel></DockPanel></Border>
                    <GridSplitter Grid.Column="1" Width="5" Background="{StaticResource PanelBorder}" />
                    <Border Grid.Column="2" Style="{StaticResource EditorPanel}"><DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="NODE CONTRACTS" FontWeight="SemiBold" /></Border><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><ListBox ItemsSource="{Binding MaterialGraphNodes}" SelectedItem="{Binding SelectedMaterialGraphNode}" DisplayMemberPath="DisplayName" BorderThickness="0" /><StackPanel Grid.Row="1" Margin="9"><TextBlock Text="TYPED PARAMETERS" Style="{StaticResource SectionLabel}" /><ItemsControl ItemsSource="{Binding MaterialGraphParameterEditors}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" /><ComboBox Grid.Column="1" ItemsSource="{Binding EnumChoices}" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Apply Parameters" Command="{Binding ApplyMaterialGraphParametersCommand}" Style="{StaticResource AccentButton}" Margin="0,7,0,0" /></StackPanel></Grid></DockPanel></Border>
                </Grid>
            </TabItem>
            <TabItem Header="UV / Attributes">
                <Grid Margin="7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource EditorPanel}"><DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="NAMED ATTRIBUTES" FontWeight="SemiBold" /></Border><ListBox ItemsSource="{Binding MeshAttributeSummaries}" BorderThickness="0" /></DockPanel></Border>
                    <GridSplitter Grid.Column="1" Width="5" Background="{StaticResource PanelBorder}" />
                    <Border Grid.Column="2" Style="{StaticResource EditorPanel}"><DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="MATERIAL SLOTS" FontWeight="SemiBold" /></Border><StackPanel><ListBox ItemsSource="{Binding MeshMaterialSlotSummaries}" BorderThickness="0" /><TextBlock Text="Attributes and slots reflect the mesh currently open in Mesh Editing. A domain-Corner attribute with a Vector2 value and a uv* name/semantic is a UV layer; this list shows every named attribute the open mesh actually carries, not a fixed UV-only view." TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="10" Margin="9" /></StackPanel></DockPanel></Border>
                </Grid>
            </TabItem>
            <TabItem Header="Animation">
                <Grid Margin="7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource EditorPanel}"><DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><TextBlock Text="ANIMATION MIXER" FontWeight="SemiBold" /></Border><StackPanel Margin="9"><TextBlock Text="Selected entity" Style="{StaticResource SectionLabel}" /><TextBlock Text="{Binding SelectedEntityId, TargetNullValue='(none - select one in the scene hierarchy)'}" TextWrapping="Wrap" Margin="0,4,0,10" /><Button Content="Open Mixer" Command="{Binding OpenAnimationMixerCommand}" Style="{StaticResource AccentButton}" /><TextBlock Text="{Binding AnimationMixerSummary}" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Margin="0,10,0,0" /><TextBlock Text="Edits the entity's authored initial mixer state, persisted the same revision-safe way as any other scene edit. Gameplay modules may still overwrite these values every frame once play starts, exactly as they can overwrite an authored Transform." TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,14,0,0" /></StackPanel></DockPanel></Border>
                    <GridSplitter Grid.Column="1" Width="5" Background="{StaticResource PanelBorder}" />
                    <Border Grid.Column="2" Style="{StaticResource EditorPanel}"><DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource EditorHeader}"><Grid><TextBlock Text="LAYERS" FontWeight="SemiBold" /><Button Content="+ Layer" HorizontalAlignment="Right" Command="{Binding AddAnimationMixerLayerCommand}" /></Grid></Border><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><ItemsControl ItemsSource="{Binding AnimationMixerLayers}" Margin="9"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="90" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Layer name" Margin="0,0,4,0" /><TextBox Grid.Column="1" Text="{Binding Clip, UpdateSourceTrigger=PropertyChanged}" ToolTip="Clip asset id" Margin="0,0,4,0" /><TextBox Grid.Column="2" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" ToolTip="Weight" Margin="0,0,4,0" /><ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.AnimationMixerLoopModes, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Text="{Binding LoopMode, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,0,4,0" /><TextBox Grid.Column="4" Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" ToolTip="Speed" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Grid.Row="1" Content="Apply Layers" Command="{Binding ApplyAnimationMixerLayersCommand}" Style="{StaticResource AccentButton}" Margin="9" /></Grid></DockPanel></Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
