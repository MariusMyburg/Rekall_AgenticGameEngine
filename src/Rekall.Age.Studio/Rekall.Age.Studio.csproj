<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rekall.Age.Studio.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rekall.Age.Core\Rekall.Age.Core.csproj" />
    <ProjectReference Include="..\Rekall.Age.Agent\Rekall.Age.Agent.csproj" />
    <ProjectReference Include="..\Rekall.Age.AssetPipeline\Rekall.Age.AssetPipeline.csproj" />
    <ProjectReference Include="..\Rekall.Age.Editor\Rekall.Age.Editor.csproj" />
    <ProjectReference Include="..\Rekall.Age.Editor.Contracts\Rekall.Age.Editor.Contracts.csproj" />
    <ProjectReference Include="..\Rekall.Age.Modeling\Rekall.Age.Modeling.csproj" />
    <ProjectReference Include="..\Rekall.Age.Modeling.Contracts\Rekall.Age.Modeling.Contracts.csproj" />
    <ProjectReference Include="..\Rekall.Age.Modules\Rekall.Age.Modules.csproj" />
    <ProjectReference Include="..\Rekall.Age.Rendering\Rekall.Age.Rendering.csproj" />
    <ProjectReference Include="..\Rekall.Age.Rendering.Windows\Rekall.Age.Rendering.Windows.csproj" />
    <ProjectReference Include="..\Rekall.Age.Runtime\Rekall.Age.Runtime.csproj" />
    <ProjectReference Include="..\Rekall.Age.Workflows\Rekall.Age.Workflows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="Veldrid" Version="4.9.0" />
    <PackageReference Include="Veldrid.SPIRV" Version="1.0.15" />
  </ItemGroup>
  <ItemGroup>
    <StudioExampleFile Include="$(MSBuildProjectDirectory)\..\..\Examples\**\*"
                       Exclude="$(MSBuildProjectDirectory)\..\..\Examples\**\.git\**;$(MSBuildProjectDirectory)\..\..\Examples\**\.rekall\**;$(MSBuildProjectDirectory)\..\..\Examples\**\.vs\**;$(MSBuildProjectDirectory)\..\..\Examples\**\bin\**;$(MSBuildProjectDirectory)\..\..\Examples\**\Builds\**;$(MSBuildProjectDirectory)\..\..\Examples\**\Captures\**;$(MSBuildProjectDirectory)\..\..\Examples\**\obj\**;$(MSBuildProjectDirectory)\..\..\Examples\**\TestResults\**;$(MSBuildProjectDirectory)\..\..\Examples\**\Transactions\**;$(MSBuildProjectDirectory)\..\..\Examples\**\Artifacts\**;$(MSBuildProjectDirectory)\..\..\Examples\**\__pycache__\**;$(MSBuildProjectDirectory)\..\..\Examples\**\*.pyc;$(MSBuildProjectDirectory)\..\..\Examples\**\Assets\Models\Compiled\**;$(MSBuildProjectDirectory)\..\..\Examples\Stride\**;$(MSBuildProjectDirectory)\..\..\Examples\Prowl\**;$(MSBuildProjectDirectory)\..\..\Examples\GlbStationTest\**;$(MSBuildProjectDirectory)\..\..\Examples\**\Assets\audio\**;$(MSBuildProjectDirectory)\..\..\Examples\**\Assets\texture\**;$(MSBuildProjectDirectory)\..\..\Examples\**\asset_menu-theme_e91ed2cf.mp3" />
    <StudioApprovedImportedAsset Include="$(MSBuildProjectDirectory)\..\..\Examples\RainGlass\Assets\texture\asset_little-redfish-lake-sunrise_58618c91.jpg"><DestinationRelativePath>RainGlass\Assets\texture\asset_little-redfish-lake-sunrise_58618c91.jpg</DestinationRelativePath></StudioApprovedImportedAsset>
  </ItemGroup>
  <ItemGroup>
    <None Update="Documentation\Rekall-AGE-Documentation.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <Target Name="CopyBundledExamples" AfterTargets="Publish">
    <Copy SourceFiles="@(StudioExampleFile)"
          DestinationFiles="@(StudioExampleFile->'$(PublishDir)Examples\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(StudioApprovedImportedAsset)"
          DestinationFiles="@(StudioApprovedImportedAsset->'$(PublishDir)Examples\%(DestinationRelativePath)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
